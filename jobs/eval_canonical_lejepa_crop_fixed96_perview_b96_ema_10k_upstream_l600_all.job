#!/bin/bash
# Full upstream-L600 StructTokenBench evaluation of a fixed-96/48, per-view
# SIGReg canonical LeJEPA EMA encoder at immutable step 10k.
# Usage: sbatch [options] this-file VARIANT
#SBATCH --job-name=stb_crop96_pv_10k
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

VARIANT="${1:?Usage: $0 VARIANT}"
PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
TRAIN_PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

case "$VARIANT" in
    protein)
        RUN_DIR=canonical_lejepa_crop_fixed96_protein_perview_sigreg_b96_100k
        EXPECTED_ALIGNMENT=protein
        EXPECTED_SIGREG_INPUT=protein_mean
        EXPECTED_RAW_SHA256=1ee8aaa31705fb353ed19d06c37c0e2347dbf7499878e6c62d078abbe4f4e054
        EXPERIMENT=canonical-lejepa-protein-perview-b96-ema-step10k
        CHECKPOINT_ENV=CANONICAL_LEJEPA_PROTEIN_PERVIEW_B96_EMA_STEP10K_CKPT
        STAGED_BASENAME=canonical-lejepa-protein-cropped-fixed96-perview-sigreg-b96-step10000-ema-staged.ckpt
        EXPECTED_JOINT_VIEWS=false
        EXPECTED_BATCH_SIZE=48
        EXPECTED_MAX_STEPS=100000
        ;;
    residue)
        RUN_DIR=canonical_lejepa_crop_fixed96_residue_perview_sigreg_b96_100k_relaunch
        EXPECTED_ALIGNMENT=residue
        EXPECTED_SIGREG_INPUT=protein_centered_residue
        EXPECTED_RAW_SHA256=639a11a9dc84692ebe477cc09ee8c63eb781a546f1187158fd6792a226be1ce6
        EXPERIMENT=canonical-lejepa-residue-perview-b96-ema-step10k
        CHECKPOINT_ENV=CANONICAL_LEJEPA_RESIDUE_PERVIEW_B96_EMA_STEP10K_CKPT
        STAGED_BASENAME=canonical-lejepa-residue-cropped-fixed96-perview-sigreg-b96-step10000-ema-staged.ckpt
        EXPECTED_JOINT_VIEWS=false
        EXPECTED_BATCH_SIZE=48
        EXPECTED_MAX_STEPS=100000
        ;;
    protein_joint_b96)
        RUN_DIR=canonical_lejepa_crop_fixed96_protein_joint_sigreg_b96_10k
        EXPECTED_ALIGNMENT=protein
        EXPECTED_SIGREG_INPUT=protein_mean
        EXPECTED_RAW_SHA256=173ce9054361ab197586c155302140e3037b24244ab9b1217a6bfb29bb2a7dd1
        EXPERIMENT=canonical-lejepa-protein-joint-b96-ema-step10k
        CHECKPOINT_ENV=CANONICAL_LEJEPA_PROTEIN_JOINT_B96_EMA_STEP10K_CKPT
        STAGED_BASENAME=canonical-lejepa-protein-cropped-fixed96-joint-sigreg-b96-step10000-ema-staged.ckpt
        EXPECTED_JOINT_VIEWS=true
        EXPECTED_BATCH_SIZE=48
        EXPECTED_MAX_STEPS=10000
        ;;
    protein_joint_b32)
        RUN_DIR=canonical_lejepa_crop_fixed96_protein_joint_sigreg_b32_100k
        EXPECTED_ALIGNMENT=protein
        EXPECTED_SIGREG_INPUT=protein_mean
        EXPECTED_RAW_SHA256=0037f4cb00122f42729a4be3791be2c68bd9a99be3e5e599602a8454c502c905
        EXPERIMENT=canonical-lejepa-protein-joint-b32-ema-step10k
        CHECKPOINT_ENV=CANONICAL_LEJEPA_PROTEIN_JOINT_B32_EMA_STEP10K_CKPT
        STAGED_BASENAME=canonical-lejepa-protein-cropped-fixed96-joint-sigreg-b32-step10000-ema-staged.ckpt
        EXPECTED_JOINT_VIEWS=true
        EXPECTED_BATCH_SIZE=16
        EXPECTED_MAX_STEPS=100000
        ;;
    *)
        echo "ERROR: unsupported variant: $VARIANT" >&2
        exit 2
        ;;
esac

RAW_CHECKPOINT="$PROJECT_ROOT/store/$RUN_DIR/checkpoints/step-00010000.ckpt"
CANONICAL_CONFIG="$PROJECT_ROOT/store/$RUN_DIR/checkpoints/exp_config_${RUN_DIR}.json"
STAGED_CHECKPOINT="$PROJECT_ROOT/store/$RUN_DIR/evaluation/$STAGED_BASENAME"

set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "canonical-lejepa" ]]; then
    echo "ERROR: expected canonical-lejepa branch" >&2
    exit 1
fi

echo "$EXPECTED_RAW_SHA256  $RAW_CHECKPOINT" | sha256sum -c -
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

"$TRAIN_PYTHON_BIN" -c '
import json
import sys
import torch

checkpoint_path, config_path, alignment, sigreg_input, joint_text, batch_text, max_steps_text = sys.argv[1:]
with open(config_path, encoding="utf-8") as handle:
    config = json.load(handle)
assert config["alignment_level"] == alignment, config["alignment_level"]
assert config["sigreg"]["input"] == sigreg_input, config["sigreg"]
assert config["sigreg"]["joint_views"] is (joint_text == "true"), config["sigreg"]
assert config["dataset"]["datamodule"]["batch_size"] == int(batch_text), config["dataset"]["datamodule"]
assert config["trainer"]["devices"] == 2, config["trainer"]
assert config["trainer"]["max_steps"] == int(max_steps_text), config["trainer"]
views = config["views"]
assert views["cropping"] is True and views["packed_views"] is True, views
assert views["global_crop_length"] == 96 and views["local_crop_length"] == 48, views
assert views["global_mask_pct"] == 0.2 and views["local_mask_pct"] == 0.5, views
assert views["num_local_views"] == 4 and views["locals_within_global"] is True, views
checkpoint = torch.load(checkpoint_path, map_location="cpu", weights_only=False, mmap=True)
assert checkpoint.get("global_step") == 10_000, checkpoint.get("global_step")
ema = checkpoint.get("state_dict_ema")
assert isinstance(ema, dict) and len(ema) == 381, len(ema or {})
ema_meta = checkpoint.get("state_dict_ema_meta", {})
assert ema_meta.get("num_updates") == 312, ema_meta
assert ema_meta.get("last_ema_step") == 9_984, ema_meta
print(f"Verified {alignment} per-view B96 EMA source: {ema_meta}")
' "$RAW_CHECKPOINT" "$CANONICAL_CONFIG" "$EXPECTED_ALIGNMENT" "$EXPECTED_SIGREG_INPUT" "$EXPECTED_JOINT_VIEWS" "$EXPECTED_BATCH_SIZE" "$EXPECTED_MAX_STEPS"

mkdir -p "$(dirname "$STAGED_CHECKPOINT")"
if [[ ! -s "$STAGED_CHECKPOINT" ]]; then
    staged_tmp="${STAGED_CHECKPOINT}.tmp-${SLURM_JOB_ID}"
    "$TRAIN_PYTHON_BIN" -m Evaluation.canonical_lejepa.stage_for_structtokenbench \
        "$RAW_CHECKPOINT" "$staged_tmp" --encoder-source=ema
    mv "$staged_tmp" "$STAGED_CHECKPOINT"
fi

"$TRAIN_PYTHON_BIN" -c '
import hashlib
import sys
import torch

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

raw_path, staged_path, expected_sha = sys.argv[1:]
raw_sha = sha256(raw_path)
assert raw_sha == expected_sha, raw_sha
staged = torch.load(staged_path, map_location="cpu", weights_only=False, mmap=True)
provenance = staged.get("canonical_lejepa_evaluation", {})
assert provenance.get("encoder_source") == "ema", provenance
assert provenance.get("source_global_step") == 10_000, provenance
assert provenance.get("source_checkpoint_sha256") == raw_sha, provenance
assert provenance.get("latent_dim") == 8, provenance
assert provenance.get("projector") is None, provenance
print(f"Verified step-10k EMA staging: {provenance}")
' "$RAW_CHECKPOINT" "$STAGED_CHECKPOINT" "$EXPECTED_RAW_SHA256"

sha256sum "$STAGED_CHECKPOINT"

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export "$CHECKPOINT_ENV=$STAGED_CHECKPOINT"
export EVALUATION_RUN_ID="slurm-${SLURM_JOB_ID}-${EXPERIMENT}-all"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-${EXPERIMENT}-all-mpl-${SLURM_JOB_ID}"
export TRITON_CACHE_DIR="/tmp/stb-${EXPERIMENT}-all-triton-${SLURM_JOB_ID}"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=10k \
    --experiment="$EXPERIMENT" \
    --tasks=all
