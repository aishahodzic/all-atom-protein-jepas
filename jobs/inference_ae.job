#!/bin/bash
#SBATCH --job-name=laproteina_ae_eval
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=00:30:00
#SBATCH --output=logs/%x-%j.out

source ~/.bashrc

conda activate /data-gauss/$USER/envs/laproteina_env

cd ~/projects/la-proteina

python proteinfoundation/partial_autoencoder/inference.py --config_name inference_ae