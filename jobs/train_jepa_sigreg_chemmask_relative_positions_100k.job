#!/bin/bash
# Matched relative-position repeats of the two reported chemical-masking runs.
# The only intended model change is replacing learned absolute position
# embeddings with clipped signed sequence-offset attention biases.
#SBATCH --job-name=chem_rel_100k
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --array=0-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00
#SBATCH --output=/slurm-storage/aishod/projects/la-proteina/logs/chem_masking/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/slurm-storage/aishod/projects/la-proteina
WORKTREE="$PROJECT_ROOT/training_worktrees/le-jepa"
PYTHON=/data-gauss/aishod/envs/laproteina_env/bin/python
RUN_ROOT=/mnt/hopper-raid/aishod/runs
TASK_TMP_ROOT="${TMPDIR:-/slurm-storage/aishod/tmp}"
TASK_TMP="$TASK_TMP_ROOT/chem-relpos-100k-${SLURM_ARRAY_JOB_ID}-${SLURM_ARRAY_TASK_ID}"

case "$SLURM_ARRAY_TASK_ID" in
    0)
        RUN_NAME=jepa_sigreg_chemmask_geometry_relpos_100k
        MASK_ARGS=(+masking_mode=chemmask_partial_coordinates +atom_mask_pct=0.5)
        ;;
    1)
        RUN_NAME=jepa_sigreg_chemmask_sidechain_noaa_relpos_100k
        MASK_ARGS=(+masking_mode=chemmask_no_aa_sidechain_partial +sidechain_mask_pct=0.5)
        ;;
    *)
        echo "ERROR: unexpected array task $SLURM_ARRAY_TASK_ID" >&2
        exit 2
        ;;
esac

RUN_DIR="$RUN_ROOT/$RUN_NAME"

set -a
source "$PROJECT_ROOT/.env"
set +a

export PYTHONPATH="$WORKTREE"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PATH="/data-gauss/aishod/envs/laproteina_env/bin:$PATH"
export TMPDIR="$TASK_TMP"

if [[ "$(git -C "$WORKTREE" branch --show-current)" != "le-jepa" ]]; then
    echo "ERROR: expected le-jepa branch in $WORKTREE" >&2
    exit 1
fi
if [[ -d "$RUN_DIR/store/$RUN_NAME/checkpoints" ]] && \
   find "$RUN_DIR/store/$RUN_NAME/checkpoints" -mindepth 1 -print -quit | grep -q .; then
    echo "ERROR: refusing to overwrite or resume existing run at $RUN_DIR" >&2
    exit 1
fi

mkdir -p "$TASK_TMP" "$RUN_DIR" "$PROJECT_ROOT/logs/chem_masking"
cd "$RUN_DIR"

IMPORTED_FROM="$($PYTHON -c 'import proteinfoundation; print(proteinfoundation.__file__)')"
if [[ "$IMPORTED_FROM" != "$WORKTREE"/proteinfoundation/* ]]; then
    echo "ERROR: proteinfoundation imported from $IMPORTED_FROM, expected $WORKTREE" >&2
    exit 1
fi

echo "Run: $RUN_NAME"
echo "Worktree commit: $(git -C "$WORKTREE" rev-parse HEAD)"
echo "Chemical mask with joint mask-token predictor and relative positions"

echo scratch | srun --ntasks=1 "$PYTHON" "$WORKTREE/proteinfoundation/jepa/train.py" \
    run_name_="$RUN_NAME" \
    +single=true \
    "${MASK_ARGS[@]}" \
    +partial_coordinate_self_exclude=false \
    +partial_coordinate_diagnostics=true \
    baseline_run_predictor=true \
    baseline_run_ema=false \
    baseline_run_layernorm=false \
    lejepa_relative_positions=true \
    predictor.relative_position_max_distance=128 \
    opt.lr=0.0001 \
    +opt.max_steps=100000 \
    opt.val_check_interval=1000 \
    log.checkpoint_every_n_steps=5000 \
    dataset.datamodule.batch_size=4 \
    dataset.datamodule.num_workers=16 \
    hardware.ngpus_per_node_=1 \
    hardware.nnodes_=1 \
    hardware.ncpus_per_task_train_=16
