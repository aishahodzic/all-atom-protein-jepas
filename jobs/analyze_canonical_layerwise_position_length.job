#!/bin/bash
# Matched layerwise position/length probes for uncropped and cropped LeJEPA.
# Array element 0 is uncropped raw-100k; element 1 is cropped per-protein raw-10k.
#SBATCH --job-name=layer_poslen
#SBATCH --partition=h100
#SBATCH --qos=short
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=03:00:00
#SBATCH --array=0-1%2
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/diagnostics/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
MODELS=(uncropped cropped_protein)
MODEL="${MODELS[$SLURM_ARRAY_TASK_ID]}"

export DATA_PATH=/mnt/hopper-raid/aishod/data
export TMPDIR="$HOME/tmp/layerwise-position-length/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
export LAYERWISE_POSITION_LENGTH_TMP="$TMPDIR"
export MPLCONFIGDIR="$TMPDIR/matplotlib"
mkdir -p "$TMPDIR" "$MPLCONFIGDIR" "$PROJECT_ROOT/logs/diagnostics"

nvidia-smi -L
cd "$PROJECT_ROOT"
"$PYTHON_BIN" Evaluation/canonical_lejepa/analyze_layerwise_position_length.py \
    --model "$MODEL" \
    --device cuda \
    --batch-size 8
