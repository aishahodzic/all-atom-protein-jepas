#!/bin/bash
#SBATCH --job-name=jepa_3dblock_d64_ln_ema_newpred_resume_100k
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00
#SBATCH --output=/slurm-storage/aishod/projects/la-proteina/logs/spatial3d_block/%x-%j.out

set -euo pipefail

WORKTREE=/slurm-storage/aishod/projects/la-proteina/training_worktrees/jepa-latent
PYTHON=/data-gauss/aishod/envs/laproteina_env/bin/python
RUN_DIR=/mnt/hopper-raid/aishod/runs/jepa_spatial3d_block_dim64_layernorm_ema_new_predictor_100k
CHECKPOINT_DIR="$RUN_DIR/store/jepa_spatial3d_block_dim64_layernorm_ema_new_predictor_100k/checkpoints"

set -a
source /slurm-storage/aishod/projects/la-proteina/.env
set +a

export PYTHONPATH="$WORKTREE"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PATH="/data-gauss/aishod/envs/laproteina_env/bin:$PATH"

if [[ "$(git -C "$WORKTREE" branch --show-current)" != "jepa-latent" ]]; then
    echo "ERROR: expected jepa-latent branch in $WORKTREE" >&2
    exit 1
fi

IMPORTED_FROM="$(cd /tmp && "$PYTHON" -c 'import proteinfoundation; print(proteinfoundation.__file__)')"
if [[ "$IMPORTED_FROM" != "$WORKTREE"/proteinfoundation/* ]]; then
    echo "ERROR: proteinfoundation imported from $IMPORTED_FROM, expected $WORKTREE" >&2
    exit 1
fi

if ! compgen -G "$CHECKPOINT_DIR/last*.ckpt" > /dev/null; then
    echo "ERROR: no last checkpoint found in $CHECKPOINT_DIR" >&2
    exit 1
fi

cd "$RUN_DIR"

echo "Worktree: $WORKTREE"
echo "Branch: $(git -C "$WORKTREE" branch --show-current)"
echo "Commit: $(git -C "$WORKTREE" rev-parse HEAD)"
echo "Import: $IMPORTED_FROM"
echo "Resuming from the latest last checkpoint in $CHECKPOINT_DIR"

printf 'last\n' | srun --ntasks=1 "$PYTHON" "$WORKTREE/proteinfoundation/jepa/train.py" \
    run_name_=jepa_spatial3d_block_dim64_layernorm_ema_new_predictor_100k \
    wandb_resume=true \
    +single=true \
    +masking_mode=spatial_3d_block \
    +opt.max_steps=100000 \
    baseline_run_layernorm=true \
    baseline_run_ema=true \
    baseline_run_predictor=true \
    nn_ae.latent_z_dim=64 \
    nn_ae.encoder.latent_z_dim=64 \
    nn_ae.decoder.latent_z_dim=64 \
    dataset.datamodule.batch_size=2 \
    dataset.datamodule.num_workers=16 \
    opt.accumulate_grad_batches=2 \
    hardware.ngpus_per_node_=1 \
    hardware.nnodes_=1 \
    hardware.ncpus_per_task_train_=16
