#!/bin/bash
# Full locked upstream-L600 STB evaluation of the final LeJEPA D8 rand70 run:
# relative predictor positions, independent target rotations, SIGReg lambda=0.01,
# old cross-attention predictor, and no EMA.
# Submit with afterok:<training-job> so only a healthy 100k run is evaluated.
#SBATCH --job-name=stb_ljr70_rr_s01
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
RUN_NAME=le_jepa_rand70_relpos_d8_rot_sigreg_0p01_10k_kn
CHECKPOINT_DIR="/mnt/hopper-raid/aishod/runs/$RUN_NAME/store/$RUN_NAME/checkpoints"
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

set -a
source "$PROJECT_ROOT/.env"
set +a

mapfile -t checkpoints < <(find "$CHECKPOINT_DIR" -maxdepth 1 -type f -name 'chk_epoch=*_step=000000100000.ckpt' -print)
if [[ "${#checkpoints[@]}" -ne 1 ]]; then
    echo "ERROR: expected exactly one immutable step-100k checkpoint, found ${#checkpoints[@]}" >&2
    printf '%s\n' "${checkpoints[@]}" >&2
    exit 1
fi
RAW_CHECKPOINT="${checkpoints[0]}"
export LEJEPA_RELROT_SIGREG_0P01_CKPT="$CHECKPOINT_DIR/stb-step-100000-sigreg-0p01.ckpt"
ln -sfn "$RAW_CHECKPOINT" "$LEJEPA_RELROT_SIGREG_0P01_CKPT"
[[ "$(readlink -f "$LEJEPA_RELROT_SIGREG_0P01_CKPT")" == "$RAW_CHECKPOINT" ]] || {
    echo "ERROR: safe checkpoint alias does not resolve to $RAW_CHECKPOINT" >&2
    exit 1
}

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "main" ]]; then
    echo "ERROR: locked evaluation must run from main" >&2
    exit 1
fi
[[ -s "$LEJEPA_RELROT_SIGREG_0P01_CKPT" ]] || { echo "ERROR: missing checkpoint" >&2; exit 1; }
echo "Checkpoint: $LEJEPA_RELROT_SIGREG_0P01_CKPT"
sha256sum "$LEJEPA_RELROT_SIGREG_0P01_CKPT"
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export EVALUATION_RUN_ID="slurm-${SLURM_JOB_ID}-le-jepa-rand70-relrot-sigreg-0p01-100k"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-ljr70-rr-s01-mpl-${SLURM_JOB_ID}"
export TRITON_CACHE_DIR="/tmp/stb-ljr70-rr-s01-triton-${SLURM_JOB_ID}"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=100k \
    --experiment=le-jepa-rand70-relative-pos-rotation-sigreg-0p01-100k \
    --tasks=all
