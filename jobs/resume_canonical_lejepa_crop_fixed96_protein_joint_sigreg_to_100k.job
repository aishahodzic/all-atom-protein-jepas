#!/bin/bash
# Resume a fixed-96/48 protein-loss, joint-view-SIGReg canonical LeJEPA run
# from its newest rolling checkpoint. The stopping step may be set independently
# of the 100k learning-rate schedule for matched interim evaluations.
# Usage: sbatch [options] this-file {b96|b32} [stop-step]
#SBATCH --job-name=canon_crop96_joint_resume
#SBATCH --partition=normal
#SBATCH --qos=long
#SBATCH --nodes=1
#SBATCH --ntasks=2
#SBATCH --ntasks-per-node=2
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=2-00:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/canonical_lejepa/%x-%j.out

set -euo pipefail

VARIANT="${1:?Usage: $0 b96-or-b32}"
STOP_STEP="${2:-100000}"
PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
case "$VARIANT" in
    b96)
        RUN_NAME=canonical_lejepa_crop_fixed96_protein_joint_sigreg_b96_10k
        PER_DEVICE_BATCH=48
        ;;
    b32)
        RUN_NAME=canonical_lejepa_crop_fixed96_protein_joint_sigreg_b32_100k
        PER_DEVICE_BATCH=16
        ;;
    *)
        echo "ERROR: variant must be b96 or b32, got: $VARIANT" >&2
        exit 2
        ;;
esac
CHECKPOINT_DIR="$PROJECT_ROOT/store/$RUN_NAME/checkpoints"

cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PATH="/slurm-storage/aishod/envs/la-proteina/bin:$PATH"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export MASTER_ADDR=127.0.0.1
export MASTER_PORT=$((20000 + SLURM_JOB_ID % 20000))
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export HYDRA_FULL_ERROR=1
export MPLCONFIGDIR="/tmp/${RUN_NAME}-resume-${SLURM_JOB_ID}"
mkdir -p "$MPLCONFIGDIR" "$PROJECT_ROOT/logs/canonical_lejepa"

RESUME_NAME=$("$PYTHON_BIN" -c \
    'import sys; from proteinfoundation.utils.fetch_last_ckpt import fetch_last_ckpt; print(fetch_last_ckpt(sys.argv[1]) or "")' \
    "$CHECKPOINT_DIR")
RESUME_CKPT="$CHECKPOINT_DIR/$RESUME_NAME"
[[ -n "$RESUME_NAME" && -f "$RESUME_CKPT" ]] || {
    echo "ERROR: no rolling last checkpoint exists in $CHECKPOINT_DIR" >&2
    exit 1
}

RESUME_STEP=$("$PYTHON_BIN" -c \
    'import sys, torch; print(int(torch.load(sys.argv[1], map_location="cpu", weights_only=False, mmap=True)["global_step"]))' \
    "$RESUME_CKPT")
if (( STOP_STEP <= 10000 || STOP_STEP > 100000 )); then
    echo "ERROR: expected 10000 < stop step <= 100000, got $STOP_STEP" >&2
    exit 1
fi
if (( RESUME_STEP < 10000 || RESUME_STEP >= STOP_STEP )); then
    echo "ERROR: expected 10000 <= resume step < $STOP_STEP, got $RESUME_STEP" >&2
    exit 1
fi

echo "Resuming $VARIANT joint-view run from $RESUME_CKPT (step $RESUME_STEP) to step $STOP_STEP"
echo "Learning-rate schedule remains configured for 100000 total steps"
echo "DDP rendezvous: ${MASTER_ADDR}:${MASTER_PORT}"

srun --ntasks=2 --kill-on-bad-exit=1 --wait=30 --label "$PYTHON_BIN" \
    -m proteinfoundation.jepa.train_canonical_lejepa \
    run_name_="$RUN_NAME" seed=42 alignment_level=protein \
    masked_kv_mode=visible_only residue_view_checkpointing=false \
    residue_compact_visible_kv=false independent_view_rotations=false \
    views.cropping=true views.packed_views=true \
    views.global_crop_length=96 views.global_crop_fraction_min=null \
    views.global_crop_fraction_max=null views.global_crop_min_length=96 \
    views.global_crop_max_length=null views.local_crop_length=48 \
    views.locals_within_global=true views.global_mask_pct=0.20 \
    views.local_mask_pct=0.50 sigreg.input=protein_mean \
    sigreg.joint_views=true \
    dataset.datamodule.dataselector.min_length=96 \
    dataset.datamodule.batch_size="$PER_DEVICE_BATCH" \
    trainer.devices=2 trainer.num_nodes=1 trainer.strategy=ddp \
    trainer.use_distributed_sampler=false trainer.precision=bf16-mixed \
    trainer.accumulate_grad_batches=1 trainer.max_steps="$STOP_STEP" \
    schedule.total_steps=100000 schedule.peak_step=12000 \
    schedule.start_lr=1.0e-4 schedule.end_lr=4.0e-4 ema.enabled=true \
    checkpoint.every_n_train_steps=10000 \
    checkpoint.last_every_n_train_steps=1500 checkpoint.save_last=true \
    checkpoint.save_weights_only=false resume.ckpt_path="$RESUME_CKPT"
