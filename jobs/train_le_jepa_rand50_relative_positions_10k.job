#!/bin/bash
# Controlled 10k intervention for the LeJEPA absolute-position shortcut.
# Keeps the historical old cross-attention predictor, but replaces its learned
# absolute target/context lookups with a shared target query and learned i-j
# target-to-context attention biases.
#SBATCH --job-name=lejepa_r50_relpos_10k
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=24
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/le_jepa/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
WORKTREE="$PROJECT_ROOT/training_worktrees/le-jepa"
PYTHON=/slurm-storage/aishod/envs/la-proteina/bin/python
RUN_NAME=le_jepa_rand50_relative_positions_10k
RUN_DIR=/mnt/hopper-raid/aishod/runs/$RUN_NAME

set -a
source "$PROJECT_ROOT/.env"
set +a

export PYTHONPATH="$WORKTREE"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PATH="/slurm-storage/aishod/envs/la-proteina/bin:$PATH"

if [[ "$(git -C "$WORKTREE" branch --show-current)" != "le-jepa" ]]; then
    echo "ERROR: expected le-jepa branch in $WORKTREE" >&2
    exit 1
fi

IMPORTED_FROM="$(cd /tmp && "$PYTHON" -c 'import proteinfoundation; print(proteinfoundation.__file__)')"
if [[ "$IMPORTED_FROM" != "$WORKTREE"/proteinfoundation/* ]]; then
    echo "ERROR: proteinfoundation imported from $IMPORTED_FROM, expected $WORKTREE" >&2
    exit 1
fi

if [[ -d "$RUN_DIR/store/$RUN_NAME/checkpoints" ]] && \
   find "$RUN_DIR/store/$RUN_NAME/checkpoints" -mindepth 1 -print -quit | grep -q .; then
    echo "ERROR: refusing to overwrite or resume existing run at $RUN_DIR" >&2
    exit 1
fi

mkdir -p "$RUN_DIR" "$PROJECT_ROOT/logs/le_jepa"
cd "$RUN_DIR"

echo "Worktree: $WORKTREE"
echo "Branch: $(git -C "$WORKTREE" branch --show-current)"
echo "Commit: $(git -C "$WORKTREE" rev-parse HEAD)"
echo "Import: $IMPORTED_FROM"
echo "Control: LeJEPA rand50, OLD cross-attention predictor, relative positions=true"
echo "No absolute predictor pos_emb; shared query + learned clipped i-j attention bias"
echo "EMA=false, LayerNorm=false, D=8, max_steps=10000"

# Store every 1k milestone so shortcut onset can be measured without retraining.
echo scratch | srun --ntasks=1 "$PYTHON" "$WORKTREE/proteinfoundation/jepa/train.py" \
    run_name_="$RUN_NAME" \
    +single=true \
    +masked_pct=0.5 \
    +opt.max_steps=10000 \
    opt.lr=0.0001 \
    baseline_run_layernorm=false \
    baseline_run_ema=false \
    baseline_run_predictor=false \
    lejepa_relative_positions=true \
    predictor.relative_position_max_distance=128 \
    nn_ae.latent_z_dim=8 \
    nn_ae.encoder.latent_z_dim=8 \
    nn_ae.decoder.latent_z_dim=8 \
    dataset.datamodule.batch_size=4 \
    dataset.datamodule.num_workers=16 \
    opt.accumulate_grad_batches=1 \
    opt.val_check_interval=2500 \
    log.checkpoint_every_n_steps=10000 \
    log.last_ckpt_every_n_steps=1500 \
    hardware.ngpus_per_node_=1 \
    hardware.nnodes_=1 \
    hardware.ncpus_per_task_train_=24
