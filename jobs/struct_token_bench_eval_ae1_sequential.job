#!/bin/bash
# AE1 StructTokenBench, all remaining tasks run sequentially on 1 GPU --
# simpler to monitor than the array (one job, one log). BindInt/BindShake
# already completed earlier and are skipped. Includes both fixes: the
# force_remove_non_standard_residues override (CatInt/CatBio crash) and
# torch.multiprocessing.set_sharing_strategy("file_system") in
# run_supervised_task.py (BindBio/Con ancdata crash after hours of runtime).
#
# Usage: sbatch jobs/struct_token_bench_eval_ae1_sequential.job
#SBATCH --job-name=stb_ae1_seq
#SBATCH --partition=normal
#SBATCH --nodelist=noether
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00
#SBATCH --output=logs/%x-%j.out

set -a
source /mnt/data/slurm-storage/aishod/projects/la-proteina/.env
set +a

cd /mnt/data/slurm-storage/aishod/projects/la-proteina/StructTokenBench

for TASK_IDX in 2 4 5 6 7 8 9 10 11 12; do
    echo "=== Starting task index $TASK_IDX ==="
    bash src/script/run_eval.sh --checkpoint=100k --experiment=ae1-external --tasks=$TASK_IDX
done
