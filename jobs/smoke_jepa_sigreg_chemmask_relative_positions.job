#!/bin/bash
# Smoke-test the two relative-position chemical-masking objectives before the
# full 100k runs. The array tasks are independent and use the short queue.
#SBATCH --job-name=smk_chem_rel
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --array=0-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=00:20:00
#SBATCH --output=/slurm-storage/aishod/projects/la-proteina/logs/chem_masking/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/slurm-storage/aishod/projects/la-proteina
WORKTREE="$PROJECT_ROOT/training_worktrees/le-jepa"
PYTHON=/data-gauss/aishod/envs/laproteina_env/bin/python
TASK_TMP_ROOT="${TMPDIR:-/slurm-storage/aishod/tmp}"
TASK_TMP="$TASK_TMP_ROOT/chem-relpos-smoke-${SLURM_ARRAY_JOB_ID}-${SLURM_ARRAY_TASK_ID}"

case "$SLURM_ARRAY_TASK_ID" in
    0)
        RUN_NAME=smoke_jepa_sigreg_chemmask_geometry_relpos
        MASK_ARGS=(+masking_mode=chemmask_partial_coordinates +atom_mask_pct=0.5)
        ;;
    1)
        RUN_NAME=smoke_jepa_sigreg_chemmask_sidechain_noaa_relpos
        MASK_ARGS=(+masking_mode=chemmask_no_aa_sidechain_partial +sidechain_mask_pct=0.5)
        ;;
    *)
        echo "ERROR: unexpected array task $SLURM_ARRAY_TASK_ID" >&2
        exit 2
        ;;
esac

set -a
source "$PROJECT_ROOT/.env"
set +a

export PYTHONPATH="$WORKTREE"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PATH="/data-gauss/aishod/envs/laproteina_env/bin:$PATH"
export TMPDIR="$TASK_TMP"

mkdir -p "$TASK_TMP" "$PROJECT_ROOT/logs/chem_masking" "$TASK_TMP/run"
cd "$TASK_TMP/run"

IMPORTED_FROM="$($PYTHON -c 'import proteinfoundation; print(proteinfoundation.__file__)')"
if [[ "$IMPORTED_FROM" != "$WORKTREE"/proteinfoundation/* ]]; then
    echo "ERROR: proteinfoundation imported from $IMPORTED_FROM, expected $WORKTREE" >&2
    exit 1
fi

echo scratch | srun --ntasks=1 "$PYTHON" "$WORKTREE/proteinfoundation/jepa/train.py" \
    run_name_="$RUN_NAME" \
    +single=true \
    "${MASK_ARGS[@]}" \
    +partial_coordinate_self_exclude=false \
    +partial_coordinate_diagnostics=true \
    baseline_run_predictor=true \
    baseline_run_ema=false \
    baseline_run_layernorm=false \
    lejepa_relative_positions=true \
    predictor.relative_position_max_distance=128 \
    opt.lr=0.0001 \
    +opt.max_steps=2 \
    opt.val_check_interval=1 \
    opt.grad_and_weight_analysis=false \
    log.log_wandb=false \
    log.checkpoint=false \
    dataset.datamodule.batch_size=4 \
    dataset.datamodule.num_workers=8 \
    hardware.ngpus_per_node_=1 \
    hardware.nnodes_=1 \
    hardware.ncpus_per_task_train_=8

