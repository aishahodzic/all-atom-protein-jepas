#!/bin/bash
# First locked-L600 STB evaluation of JEPA+SIGReg mutation (le-jepa-mutation).
# Per RESULTS_DRAFT_COMMENT_REVIEW.md item 17: "JEPA: L600 complete.
# JEPA+SIGReg: L256 complete; no L600 found after checking branches, outputs
# and Slurm." This closes that gap. Standard final-latent (8D) readout, no
# block override -- matches how plain jepa-mutation is already reported.
# Fast group: BindShake, Ept, Rep, FlexRMSF, FlexBFactor, FlexNEQ.
#SBATCH --job-name=stb_lejepa_mut_fast
#SBATCH --partition=normal
#SBATCH --nodelist=noether  # gauss/klein currently fail nvmlInit_v2 (driver/library mismatch)
#SBATCH --qos=short
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
CHECKPOINT="$STB_ROOT/100k-checkpoints/le-jepa/mutation/100k.ckpt"
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

set -a
source "$PROJECT_ROOT/.env"
set +a

echo "c1de4c3ca8a754be7ec20d39a2e8d1cf69916770e099a262c617ca214735bf05  $CHECKPOINT" | sha256sum -c -
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export STB_SHARED_EMBEDDING_CACHE_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data/shared_embedding_cache
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export ENCODER_SOURCE=online
export EVALUATION_RUN_ID="slurm-${SLURM_JOB_ID}-le-jepa-mutation-100k-fast"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export TMPDIR="$HOME/tmp/stb-lejepa-mut-fast/${SLURM_JOB_ID}"
export MPLCONFIGDIR="$TMPDIR/matplotlib"
export TRITON_CACHE_DIR="$TMPDIR/triton"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=100k \
    --experiment=le-jepa-mutation \
    --tasks=BindShake,Ept,Rep,FlexRMSF,FlexBFactor,FlexNEQ
