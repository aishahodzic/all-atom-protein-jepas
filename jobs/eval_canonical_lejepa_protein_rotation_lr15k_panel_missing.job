#!/bin/bash
# Complete the matched seven-benchmark panel for per-protein + rotations:
# array 0 = High LR raw 15,000; array 1 = Middle LR raw 15,980.
# Ept and the three Flex benchmarks are evaluated separately; this adds
# The two shortest Binding/Catalytic benchmarks (BindInt, BindShake).
#SBATCH --job-name=stb_protrot_lr15_m3
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=01:30:00
#SBATCH --array=0-1
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

EXPERIMENTS=(
    canonical-lejepa-protein-perview-rot-high-lr-raw-step15k
    canonical-lejepa-protein-perview-rot-middle-lr-raw-step15980
)
CHECKPOINTS=(
    "$PROJECT_ROOT/store/canonical_lejepa_crop_fixed96_protein_perview_sigreg_b96_independent_locals_rotations_lr1e3_cosine_17k/evaluation/canonical-lejepa-protein-perview-rot-high-lr-step15000-raw-staged.ckpt"
    "$STB_ROOT/100k-checkpoints/canonical-lejepa/jarvis/rotation/CLJP_step-00015980-raw-stb.ckpt"
)
STEPS=(15000 15980)
SOURCE_SHA256=(
    0b0709f6d8af45aa1ce9e451c4f9ae2156701e46c04e1d54cae08322d2674703
    4126b308c6887c396c31a8a24faaa0c69922fecb24d70f8c0c27433162d3fc3f
)

INDEX=$SLURM_ARRAY_TASK_ID
EXPERIMENT="${EXPERIMENTS[$INDEX]}"
CHECKPOINT="${CHECKPOINTS[$INDEX]}"
STEP="${STEPS[$INDEX]}"
EXPECTED_SOURCE_SHA="${SOURCE_SHA256[$INDEX]}"

test -s "$CHECKPOINT"
test -s "$ENCODER_CONFIG"

"$STB_PYTHON_BIN" -c '
import sys
import torch

checkpoint = torch.load(sys.argv[1], map_location="cpu", weights_only=False, mmap=True)
provenance = checkpoint.get("canonical_lejepa_evaluation", {})
assert provenance.get("source_global_step") == int(sys.argv[2]), provenance
assert provenance.get("encoder_source") == "raw", provenance
assert provenance.get("source_checkpoint_sha256") == sys.argv[3], provenance
assert provenance.get("latent_dim") == 8, provenance
assert sum(str(k).startswith("online_encoder.") for k in checkpoint.get("state_dict", {})) == 381
print(f"Verified per-protein + rotations raw step-{sys.argv[2]} checkpoint")
' "$CHECKPOINT" "$STEP" "$EXPECTED_SOURCE_SHA"

cd "$STB_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export STB_SHARED_EMBEDDING_CACHE_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data/shared_embedding_cache
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export CANONICAL_LEJEPA_PROTEIN_PERVIEW_ROT_HIGH_LR_RAW_STEP15K_CKPT="${CHECKPOINTS[0]}"
export CANONICAL_LEJEPA_PROTEIN_PERVIEW_ROT_MIDDLE_LR_RAW_STEP15980_CKPT="${CHECKPOINTS[1]}"
export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${INDEX}-${EXPERIMENT}-panel-missing-three"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export TMPDIR="$HOME/tmp/stb-protrot-lr15-m3/${SLURM_ARRAY_JOB_ID}_${INDEX}"
export MPLCONFIGDIR="$TMPDIR/matplotlib"
export TRITON_CACHE_DIR="$TMPDIR/triton"
mkdir -p "$STB_LOG_ROOT" "$TMPDIR" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR" "$STB_SHARED_EMBEDDING_CACHE_ROOT"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint="$STEP" \
    --experiment="$EXPERIMENT" \
    --tasks=BindInt,BindShake
