#!/bin/bash
# Matched cheap EMA residue diagnostics for the fixed-96/48, joint-SIGReg,
# global-batch-96 protein run at 10k and 20k. No t-SNE or downstream probes.
#SBATCH --job-name=diag_joint_b96_10k20k
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/canonical_lejepa/%x-%j.out

set -euo pipefail
PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PATH="/slurm-storage/aishod/envs/la-proteina/bin:$PATH"
export MPLCONFIGDIR="/tmp/canonical-protein-joint-b96-diagnostics-${SLURM_JOB_ID}"
mkdir -p "$MPLCONFIGDIR" "$PROJECT_ROOT/logs/canonical_lejepa"

for profile in \
    protein-joint-b96-cropped-fixed96-10k \
    protein-joint-b96-cropped-fixed96-20k
do
    export CANONICAL_RESIDUE_ANALYSIS_PROFILE="$profile"
    srun --ntasks=1 "$PYTHON_BIN" \
        Evaluation/diagnostics/analyze_canonical_residue_ab_10k.py
done
