#!/bin/bash
# Resume only the tasks not completed by Slurm job 257092, using the tested
# checkpoint-and-structure shared embedding cache across those tasks.
#
# Completed by 257092 and intentionally omitted:
# BindInt, BindBio, BindShake, CatInt, CatBio, Con.
#
# Submit only after Con's immutable manifest exists and 257092 is cancelled.
#SBATCH --job-name=stb_lejepa_rel70_shared_tail
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=16:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
CHECKPOINT_DIR=/mnt/hopper-raid/aishod/runs/le_jepa_rand70_relative_positions_100k/store/le_jepa_rand70_relative_positions_100k/checkpoints
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
CON_MANIFEST="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/slurm-257092-le-jepa-rand70-relative-pos-100k/manifests/slurm-257092-le-jepa-rand70-relative-pos-100k/100k__le-jepa-rand70-relative-pos-100k-upstream-l600-v1__Con.json"

[[ -s "$CON_MANIFEST" ]] || {
    echo "ERROR: Con from job 257092 is not safely complete: $CON_MANIFEST" >&2
    exit 1
}

set -a
source "$PROJECT_ROOT/.env"
set +a

mapfile -t checkpoints < <(find "$CHECKPOINT_DIR" -maxdepth 1 -type f -name 'chk_epoch=*_step=000000100000.ckpt' -print)
if [[ "${#checkpoints[@]}" -ne 1 ]]; then
    echo "ERROR: expected exactly one immutable step-100k checkpoint, found ${#checkpoints[@]}" >&2
    printf '%s\n' "${checkpoints[@]}" >&2
    exit 1
fi
RAW_CHECKPOINT="${checkpoints[0]}"
export LEJEPA_RELATIVE_POS_R70_CKPT="$CHECKPOINT_DIR/stb-step-100000.ckpt"
ln -sfn "$RAW_CHECKPOINT" "$LEJEPA_RELATIVE_POS_R70_CKPT"
[[ "$(readlink -f "$LEJEPA_RELATIVE_POS_R70_CKPT")" == "$RAW_CHECKPOINT" ]] || {
    echo "ERROR: safe checkpoint alias does not resolve to $RAW_CHECKPOINT" >&2
    exit 1
}

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "main" ]]; then
    echo "ERROR: locked evaluation must run from main" >&2
    exit 1
fi
[[ -s "$LEJEPA_RELATIVE_POS_R70_CKPT" ]] || { echo "ERROR: missing checkpoint" >&2; exit 1; }
echo "Checkpoint: $LEJEPA_RELATIVE_POS_R70_CKPT"
sha256sum "$LEJEPA_RELATIVE_POS_R70_CKPT"
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export STB_SHARED_EMBEDDING_CACHE_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data/shared_embedding_cache
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export EVALUATION_RUN_ID="slurm-257092-le-jepa-rand70-relative-pos-100k"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-lejepa-rel70-shared-tail-mpl-${SLURM_JOB_ID}"
export TRITON_CACHE_DIR="/tmp/stb-lejepa-rel70-shared-tail-triton-${SLURM_JOB_ID}"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR" "$STB_SHARED_EMBEDDING_CACHE_ROOT"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=100k \
    --experiment=le-jepa-rand70-relative-pos-100k \
    --tasks=Rep,Ept,FlexRMSF,FlexBFactor,FlexNEQ,Homo
