#!/bin/bash
#SBATCH --job-name=canon_pack_b16
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=00:30:00
#SBATCH --output=logs/canonical_lejepa/canonical_packed_b16-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python

cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/.env"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export MPLCONFIGDIR="/tmp/canonical-packed-b16-${SLURM_JOB_ID}"
mkdir -p "$MPLCONFIGDIR"
mkdir -p "$PROJECT_ROOT/logs/canonical_lejepa"

srun "$PYTHON_BIN" -m proteinfoundation.jepa.benchmark_canonical_packed_memory \
    --mode full \
    --batch-size 16 \
    --num-workers 0
