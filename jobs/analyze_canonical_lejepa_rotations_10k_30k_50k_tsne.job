#!/bin/bash
# Matched frozen-EMA 10k/30k/50k t-SNE and latent audit for the canonical
# independent-SO(3)-view-rotation ablation.  The live trainer may keep running:
# this job reads only immutable numbered checkpoints.
#SBATCH --job-name=canonical_rot_10k_30k_50k_tsne
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/canonical_lejepa/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
CHECKPOINT_DIR="$PROJECT_ROOT/store/canonical_lejepa_rotations_100k/checkpoints"

cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
if [[ "$(hostname -s)" == "hopper" ]]; then
    export DATA_PATH="${DATA_PATH/\/mnt\/hopper-raid/\/mnt\/raid}"
fi
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PATH="/slurm-storage/aishod/envs/la-proteina/bin:$PATH"
export MPLCONFIGDIR="/tmp/canonical-rot-10k-30k-50k-tsne-${SLURM_JOB_ID}"
mkdir -p "$MPLCONFIGDIR" "$PROJECT_ROOT/logs/canonical_lejepa"

for step in 00010000 00030000 00050000; do
    checkpoint="$CHECKPOINT_DIR/step-${step}.ckpt"
    [[ -s "$checkpoint" ]] || {
        echo "ERROR: missing immutable rotation checkpoint: $checkpoint" >&2
        exit 1
    }
done

srun "$PYTHON_BIN" \
    Evaluation/latent_viz/analyze_canonical_lejepa_rotations_10k_30k_50k.py
