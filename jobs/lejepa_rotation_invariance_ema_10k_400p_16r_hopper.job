#!/bin/bash
#SBATCH --job-name=lejepa_so3_invariance
#SBATCH --partition=h100
#SBATCH --nodelist=hopper
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --chdir=/mnt/data/slurm-storage/aishod/projects/la-proteina
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/mnt/data/slurm-storage/aishod/.conda/envs/pstbench/bin/python
SCRATCH_ROOT="$HOME/tmp/lejepa_rotation_invariance_${SLURM_JOB_ID}"
mkdir -p "$SCRATCH_ROOT"
export TMPDIR="$SCRATCH_ROOT"
export MPLCONFIGDIR="$SCRATCH_ROOT/matplotlib"
export DATA_PATH=/mnt/hopper-raid/aishod/data
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

exec "$PYTHON_BIN" Evaluation/diagnostics/run_lejepa_rotation_invariance_cohort.py \
    --n-proteins "${N_PROTEINS:-400}" --n-rotations "${N_ROTATIONS:-16}" \
    --batch-size "${BATCH_SIZE:-4}" --seed "${COHORT_SEED:-20260918}"
