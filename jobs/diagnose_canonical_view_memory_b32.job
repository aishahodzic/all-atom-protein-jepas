#!/bin/bash
#SBATCH --job-name=canonical_view_mem
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --nodelist=noether
#SBATCH --gres=gpu:1
#SBATCH --array=0-1%2
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=00:20:00
#SBATCH --output=logs/canonical_lejepa/canonical_view_mem-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
VIEWS=(global local)
VIEW="${VIEWS[$SLURM_ARRAY_TASK_ID]}"

cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/.env"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export MPLCONFIGDIR="/tmp/canonical-view-memory-${SLURM_ARRAY_JOB_ID}-${SLURM_ARRAY_TASK_ID}"
mkdir -p "$MPLCONFIGDIR"

srun "$PYTHON_BIN" -m proteinfoundation.jepa.diagnose_canonical_view_memory \
    --view "$VIEW" \
    --num-workers 0
