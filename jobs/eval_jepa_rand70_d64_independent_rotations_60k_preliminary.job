#!/bin/bash
# Fast representative STB panel for the already-collapsed 60k checkpoint.
# Covers local binding/catalysis, flexibility, and global homology.
#SBATCH --job-name=stb_jepa_d64_rot_60k_prelim
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
CHECKPOINT_DIR=/mnt/hopper-raid/aishod/runs/jepa_rand70_d64_independent_rotations_10k/store/jepa_rand70_d64_independent_rotations_10k/checkpoints
RAW_CHECKPOINT="$CHECKPOINT_DIR/chk_epoch=00000011_step=000000060000.ckpt"
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

set -a
source "$PROJECT_ROOT/.env"
set +a

export JEPA_RAND70_D64_INDEPENDENT_ROTATIONS_CKPT="$CHECKPOINT_DIR/stb-step-60000.ckpt"
ln -sfn "$RAW_CHECKPOINT" "$JEPA_RAND70_D64_INDEPENDENT_ROTATIONS_CKPT"
[[ "$(readlink -f "$JEPA_RAND70_D64_INDEPENDENT_ROTATIONS_CKPT")" == "$RAW_CHECKPOINT" ]] || {
    echo "ERROR: safe checkpoint alias does not resolve to $RAW_CHECKPOINT" >&2
    exit 1
}

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "main" ]]; then
    echo "ERROR: locked evaluation must run from main" >&2
    exit 1
fi
[[ -s "$RAW_CHECKPOINT" ]] || { echo "ERROR: missing 60k checkpoint: $RAW_CHECKPOINT" >&2; exit 1; }
echo "Checkpoint: $RAW_CHECKPOINT"
sha256sum "$RAW_CHECKPOINT"
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export EVALUATION_RUN_ID="slurm-${SLURM_JOB_ID}-jepa-rand70-d64-independent-rotations-60k-prelim"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-jepa-d64-rot-60k-mpl-${SLURM_JOB_ID}"
export TRITON_CACHE_DIR="/tmp/stb-jepa-d64-rot-60k-triton-${SLURM_JOB_ID}"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=60k \
    --experiment=jepa-rand70-d64-independent-rotations-100k \
    --tasks=BindInt,CatInt,FlexRMSF,Homo
