#!/bin/bash
#SBATCH --job-name=canon_evopair_sweep
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --nodelist=noether
#SBATCH --nodes=1
#SBATCH --ntasks=2
#SBATCH --ntasks-per-node=2
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=01:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/canonical_lejepa/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python

cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a

export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PATH="/slurm-storage/aishod/envs/la-proteina/bin:$PATH"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

run_variant() {
    local suffix=$1
    local sigreg_weight=$2
    local joint_views=$3
    local rotations=$4
    local run_name="canonical_lejepa_v1_evopair_rescue_${suffix}_250step"
    export MPLCONFIGDIR="$PROJECT_ROOT/store/$run_name/matplotlib-cache"
    mkdir -p "$MPLCONFIGDIR" "$PROJECT_ROOT/logs/canonical_lejepa"

    srun --ntasks=2 "$PYTHON_BIN" \
        -m proteinfoundation.jepa.train_canonical_lejepa \
        run_name_="$run_name" \
        seed=42 \
        pair_only_position_information=true \
        pair_only_evolving_pair_repr=true \
        independent_view_rotations="$rotations" \
        alignment_level=protein \
        masked_kv_mode=visible_only \
        views.cropping=false \
        views.global_mask_pct=0.20 \
        views.local_mask_pct=0.80 \
        views.num_local_views=4 \
        views.packed_views=true \
        views.physical_token_drop=false \
        readout.type=mean_visible_residues \
        sigreg.input=protein_mean \
        sigreg.weight="$sigreg_weight" \
        sigreg.knots=17 \
        sigreg.num_proj=1024 \
        sigreg.normalize_by_n=false \
        sigreg.joint_views="$joint_views" \
        dataset.datamodule.batch_size=8 \
        optimizer.type=AdamW \
        optimizer.lr=4.0e-4 \
        optimizer.weight_decay=0.04 \
        optimizer.betas='[0.9,0.95]' \
        optimizer.amsgrad=false \
        optimizer.exclude_bias_norm=true \
        schedule.type=LinearWarmupCosineAnnealing \
        schedule.total_steps=100000 \
        schedule.peak_step=12000 \
        schedule.start_lr=1.0e-4 \
        schedule.end_lr=4.0e-4 \
        ema.enabled=true \
        ema.decay=0.9999 \
        ema.update_every=32 \
        ema.start_step=0 \
        ema.include='[encoder]' \
        ema.save_key=state_dict_ema \
        ema.device=cuda \
        ema.dtype=float32 \
        trainer.devices=2 \
        trainer.num_nodes=1 \
        trainer.strategy=ddp \
        trainer.use_distributed_sampler=false \
        trainer.precision=bf16-mixed \
        trainer.max_steps=250 \
        trainer.accumulate_grad_batches=1 \
        trainer.limit_val_batches=0 \
        trainer.gradient_clip_val=null \
        checkpoint.every_n_train_steps=10000 \
        checkpoint.last_every_n_train_steps=250
}

run_variant sigreg_w0p10_perview_rot 0.10 false true
run_variant sigreg_w0p02_joint_rot 0.02 true true
run_variant sigreg_w0p10_joint_rot 0.10 true true
run_variant sigreg_w0p02_perview_norot 0.02 false false
