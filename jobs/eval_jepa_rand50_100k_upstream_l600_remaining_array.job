#!/bin/bash
# Continuation after the original all-task job is stopped following BindBio.
# Flex and the Con/Rep/Ept/Homo tail are owned by separate arrays, so this job
# deliberately contains only the three otherwise-unowned tasks.
# Each array element also refuses to rerun a task with an immutable manifest.
#SBATCH --job-name=stb_jepa_r50_rem
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodelist=gauss
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-2
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
CHECKPOINT="$STB_ROOT/100k-checkpoints/jepa/random_masking_50pct/100k.ckpt"
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
TASKS=(BindShake CatInt CatBio)
TASK="${TASKS[$SLURM_ARRAY_TASK_ID]}"
PROTOCOL_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs"

set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "main" ]]; then
    echo "ERROR: locked evaluation must run from main" >&2
    exit 1
fi

echo "bbc0761375db3813c981e4d09379b57b314085db2c412d06bf0ace2e56523896  $CHECKPOINT" | sha256sum -c -
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

shopt -s nullglob
existing_manifests=(
    "$PROTOCOL_ROOT"/*/manifests/*/100k__jepa-rand-mask-50-upstream-l600-v1__"$TASK".json
)
if (( ${#existing_manifests[@]} > 0 )); then
    echo "SKIP: $TASK already has immutable manifest: ${existing_manifests[0]}"
    exit 0
fi

cd "$STB_ROOT"

export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN
export NUM_WORKERS=4
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-jepa-rand-mask-50-100k-${TASK}"
export STB_LOG_ROOT="$PROTOCOL_ROOT/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-jepa-r50-rem-mpl-${SLURM_ARRAY_JOB_ID}-${SLURM_ARRAY_TASK_ID}"
export TRITON_CACHE_DIR="/tmp/stb-jepa-r50-rem-triton-${SLURM_ARRAY_JOB_ID}-${SLURM_ARRAY_TASK_ID}"

mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=100k \
    --experiment=jepa-rand-mask-50 \
    --tasks="$TASK"
