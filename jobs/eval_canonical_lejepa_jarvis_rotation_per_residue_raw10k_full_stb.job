#!/bin/bash
# Full 12-task upstream-L600 STB evaluation for the Jarvis rotation and
# per-residue canonical LeJEPA raw step-10k encoders.
# Array 0: rotation; array 1: per-residue.
#SBATCH --job-name=stb_rot_res10
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --array=0-1
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

EXPERIMENTS=(
    canonical-lejepa-jarvis-rotation-raw-step10k
    canonical-lejepa-jarvis-per-residue-raw-step10k
)
CHECKPOINTS=(
    "$STB_ROOT/100k-checkpoints/canonical-lejepa/jarvis/rotation/CLJP_step-00010000-raw-stb.ckpt"
    "$STB_ROOT/100k-checkpoints/canonical-lejepa/jarvis/per-residue/CLJP_step-00010000-raw-stb.ckpt"
)
STAGED_SHA256=(
    e54c681658f5288c7ecc65f50db4afeaa53f93465e5f61902319cbda5bdc47a1
    0ce648d7b094e36cc48319c9f27f3fa86d6a4a02cd2511583a22748f420087d2
)
SOURCE_SHA256=(
    06bec76f5bf695ef930f494cdc5449c34375854b91fe53f7876bf74edd897607
    c010ba58ea65016497c79cf17b16341c22a919df36124310e1ae11fef3e94871
)

EXPERIMENT="${EXPERIMENTS[$SLURM_ARRAY_TASK_ID]}"
CHECKPOINT="${CHECKPOINTS[$SLURM_ARRAY_TASK_ID]}"
EXPECTED_STAGED_SHA="${STAGED_SHA256[$SLURM_ARRAY_TASK_ID]}"
EXPECTED_SOURCE_SHA="${SOURCE_SHA256[$SLURM_ARRAY_TASK_ID]}"

test -f "$CHECKPOINT"
test -f "$ENCODER_CONFIG"
echo "$EXPECTED_STAGED_SHA  $CHECKPOINT" | sha256sum -c -

"$STB_PYTHON_BIN" -c '
import sys
import torch

checkpoint = torch.load(sys.argv[1], map_location="cpu", weights_only=False, mmap=True)
provenance = checkpoint.get("canonical_lejepa_evaluation", {})
assert provenance.get("source_global_step") == 10_000, provenance
assert provenance.get("encoder_source") == "raw", provenance
assert provenance.get("source_checkpoint_sha256") == sys.argv[2], provenance
assert provenance.get("latent_dim") == 8, provenance
state = checkpoint.get("state_dict", {})
online = [key for key in state if key.startswith("online_encoder.")]
assert len(online) == 381, len(online)
print("Verified raw step-10k STB checkpoint with 381 encoder tensors")
' "$CHECKPOINT" "$EXPECTED_SOURCE_SHA"

cd "$STB_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-${EXPERIMENT}-full-stb"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="$HOME/tmp/stb-runtime-cache/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-jarvis10/mpl"
export TRITON_CACHE_DIR="$HOME/tmp/stb-runtime-cache/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-jarvis10/triton"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=10k \
    --experiment="$EXPERIMENT" \
    --tasks=all
