#!/bin/bash
# Full locked upstream-L600 StructTokenBench evaluations for the two matched
# relative-position chemical-masking runs. Submit after training array 260860.
#SBATCH --job-name=stb_chem_rel_100k
#SBATCH --partition=h100
#SBATCH --nodelist=hopper
#SBATCH --qos=medium
#SBATCH --array=0-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=100G
#SBATCH --time=1-00:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

RUN_NAMES=(
    jepa_sigreg_chemmask_geometry_relpos_100k
    jepa_sigreg_chemmask_sidechain_noaa_relpos_100k
)
EXPERIMENTS=(
    jepa-sigreg-chemmask-geometry-relpos-100k
    jepa-sigreg-chemmask-sidechain-noaa-relpos-100k
)

RUN_NAME="${RUN_NAMES[$SLURM_ARRAY_TASK_ID]}"
EXPERIMENT="${EXPERIMENTS[$SLURM_ARRAY_TASK_ID]}"
CHECKPOINT_DIR="/mnt/hopper-raid/aishod/runs/$RUN_NAME/store/$RUN_NAME/checkpoints"

mapfile -t checkpoints < <(find "$CHECKPOINT_DIR" -maxdepth 1 -type f -name 'chk_epoch=*_step=000000100000.ckpt' -print)
if [[ "${#checkpoints[@]}" -ne 1 ]]; then
    echo "ERROR: expected exactly one immutable step-100k checkpoint, found ${#checkpoints[@]}" >&2
    printf '%s\n' "${checkpoints[@]}" >&2
    exit 1
fi
RAW_CHECKPOINT="${checkpoints[0]}"
# Hydra parses the '=' characters in Lightning's checkpoint filename as
# override syntax. Use a stable alias whose path is safe to pass as a value.
CHECKPOINT="$CHECKPOINT_DIR/stb-step-100000.ckpt"
ln -sfn "$RAW_CHECKPOINT" "$CHECKPOINT"
[[ "$CHECKPOINT" -ef "$RAW_CHECKPOINT" ]] || {
    echo "ERROR: safe checkpoint alias does not resolve to $RAW_CHECKPOINT" >&2
    exit 1
}

case "$SLURM_ARRAY_TASK_ID" in
    0) export CHEMMASK_GEOMETRY_RELPOS_CKPT="$CHECKPOINT" ;;
    1) export CHEMMASK_SIDECHAIN_NOAA_RELPOS_CKPT="$CHECKPOINT" ;;
    *) echo "ERROR: unexpected array task $SLURM_ARRAY_TASK_ID" >&2; exit 2 ;;
esac

set -a
source "$PROJECT_ROOT/.env"
set +a

[[ -s "$CHECKPOINT" ]] || { echo "ERROR: missing checkpoint: $CHECKPOINT" >&2; exit 1; }
echo "Checkpoint: $CHECKPOINT"
sha256sum "$CHECKPOINT"
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -
echo "Repository revision: $(git -C "$PROJECT_ROOT" rev-parse HEAD)"

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export STB_SHARED_EMBEDDING_CACHE_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data/shared_embedding_cache
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN
export NUM_WORKERS=8
export DATA_PATH=/mnt/hopper-raid/aishod/data
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export ENCODER_SOURCE=online
export WANDB_MODE=disabled
export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-${EXPERIMENT}"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export TMPDIR="$HOME/tmp/stb-chem-relpos-100k/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
export MPLCONFIGDIR="$TMPDIR/matplotlib"
export TRITON_CACHE_DIR="$TMPDIR/triton"
export TORCH_EXTENSIONS_DIR="$TMPDIR/torch-extensions"

[[ -d "$STB_SHARED_EMBEDDING_CACHE_ROOT/v1" && -r "$STB_SHARED_EMBEDDING_CACHE_ROOT/v1" ]]
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR" "$TORCH_EXTENSIONS_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=100k \
    --experiment="$EXPERIMENT" \
    --tasks=all
