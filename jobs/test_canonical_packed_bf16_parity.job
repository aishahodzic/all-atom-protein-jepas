#!/bin/bash
#SBATCH --job-name=canonical_pack_parity
#SBATCH --partition=h100
#SBATCH --qos=short
#SBATCH --nodelist=hopper
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=24G
#SBATCH --time=00:15:00
#SBATCH --output=logs/canonical_lejepa/canonical_packed_bf16_parity-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export MPLCONFIGDIR="/tmp/canonical-packed-parity-${SLURM_JOB_ID}"
mkdir -p "$MPLCONFIGDIR"

srun "$PYTHON_BIN" -m unittest \
  proteinfoundation.jepa.tests.test_canonical_lejepa_packed.CanonicalPackedParityTest.test_cuda_bf16_embeddings_losses_and_gradients_match \
  -v
