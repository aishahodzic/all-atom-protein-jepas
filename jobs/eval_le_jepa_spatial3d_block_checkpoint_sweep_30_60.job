#!/bin/bash
#SBATCH --job-name=stb_lejepa_block_sweep
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --time=05:00:00
#SBATCH --array=0-1
#SBATCH --output=/slurm-storage/aishod/projects/la-proteina/logs/stb/spatial3d_block/%x-%A_%a.out

set -euo pipefail

REPO=/slurm-storage/aishod/projects/la-proteina
STB="$REPO/StructTokenBench"
STEPS=(30k 60k)
STEP="${STEPS[$SLURM_ARRAY_TASK_ID]}"
EXPERIMENT="le-jepa-spatial3d-block-$STEP"
CKPT="$STB/100k-checkpoints/le-jepa/spatial3d_block_dim64_new_predictor/$STEP.ckpt"
SWEEP_ROOT="$STB/struct_token_bench_logs/checkpoint_sweeps/le_jepa_spatial3d_block/$STEP"

set -a
source "$REPO/.env"
set +a

export DS_IGNORE_CUDA_DETECTION=1

if [[ "$(git -C "$REPO" branch --show-current)" != "main" ]]; then
    echo "ERROR: StructTokenBench must run from the main branch" >&2
    exit 1
fi

if [[ ! -s "$CKPT" ]]; then
    echo "ERROR: checkpoint is missing or empty: $CKPT" >&2
    exit 1
fi

if [[ ! -d "$STB/pdb_data/mmcif_files" ]]; then
    echo "ERROR: STB mmCIF data link is unavailable: $STB/pdb_data" >&2
    exit 1
fi

mkdir -p "$SWEEP_ROOT"
export STB_LOG_ROOT="$SWEEP_ROOT/logs"
export SUMMARY_FILE="$SWEEP_ROOT/summary_results.csv"

cd "$STB"
bash src/script/run_eval.sh \
    --checkpoint="$STEP" \
    --experiment="$EXPERIMENT" \
    --tasks=all
