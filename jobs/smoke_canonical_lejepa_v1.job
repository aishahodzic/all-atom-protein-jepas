#!/bin/bash
#SBATCH --job-name=canonical_v1_smoke
#SBATCH --partition=h100
#SBATCH --qos=short
#SBATCH --nodelist=hopper
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=128G
#SBATCH --time=00:30:00
#SBATCH --output=logs/canonical_lejepa/canonical_v1_smoke-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python

cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/.env"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export MPLCONFIGDIR="/tmp/canonical-lejepa-smoke-${SLURM_JOB_ID}"
mkdir -p "$MPLCONFIGDIR"

srun "$PYTHON_BIN" -m proteinfoundation.jepa.smoke_canonical_lejepa --num-workers 0
