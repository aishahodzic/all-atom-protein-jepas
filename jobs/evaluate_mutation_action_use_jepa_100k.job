#!/bin/bash
#SBATCH --job-name=mut_action_jepa
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --array=42-44
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/mutation_action/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
WORKTREE="$PROJECT_ROOT/training_worktrees/jepa-latent"
CHECKPOINT="$PROJECT_ROOT/StructTokenBench/100k-checkpoints/jepa/mutation/100k.ckpt"
ENCODER_CONFIG="$PROJECT_ROOT/StructTokenBench/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
OUTPUT_DIR="$PROJECT_ROOT/Evaluation/diagnostics/results/mutation_action_use"
SEED="$SLURM_ARRAY_TASK_ID"
TASK_TMP="$HOME/tmp/mutation_action_use_${SLURM_ARRAY_JOB_ID}_${SEED}"

mkdir -p "$PROJECT_ROOT/logs/mutation_action" "$OUTPUT_DIR" "$TASK_TMP"
export TMPDIR="$TASK_TMP"
export MPLCONFIGDIR="$TASK_TMP/matplotlib"
export TRITON_CACHE_DIR="$TASK_TMP/triton"
export PYTHONPATH="$WORKTREE"

cd "$WORKTREE"
srun --ntasks=1 "$PYTHON_BIN" \
    "$PROJECT_ROOT/Evaluation/diagnostics/evaluate_mutation_action_use.py" \
    --checkpoint "$CHECKPOINT" \
    --encoder-config "$ENCODER_CONFIG" \
    --family jepa \
    --num-proteins 512 \
    --batch-size 8 \
    --num-workers 0 \
    --seed "$SEED" \
    --output-json "$OUTPUT_DIR/jepa_mutation_100k_seed${SEED}.json" \
    --output-csv "$OUTPUT_DIR/jepa_mutation_100k_seed${SEED}_per_protein.csv"
