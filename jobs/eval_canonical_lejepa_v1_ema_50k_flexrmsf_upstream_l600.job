#!/bin/bash
# Locked upstream-L600 FlexRMSF probe for canonical LeJEPA V1's step-50k EMA
# encoder. Submit afterok on wait_canonical_lejepa_v1_50k_checkpoint.job.
#SBATCH --job-name=stb_canon_lj_50k_rmsf
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
TRAIN_PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
RAW_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_v1_100k/checkpoints/step-00050000.ckpt"
STAGED_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_v1_100k/evaluation/canonical-lejepa-v1-step50000-ema-staged.ckpt"
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "canonical-lejepa" ]]; then
    echo "ERROR: expected canonical-lejepa branch" >&2
    exit 1
fi

"$TRAIN_PYTHON_BIN" -c '
import sys
import torch

path = sys.argv[1]
checkpoint = torch.load(path, map_location="cpu", weights_only=False)
assert checkpoint.get("global_step") == 50_000, checkpoint.get("global_step")
ema = checkpoint.get("state_dict_ema")
assert isinstance(ema, dict) and len(ema) > 0
meta = checkpoint.get("state_dict_ema_meta", {})
assert meta.get("last_ema_step") == 49_984, meta
print(
    "Source step={}, EMA tensors={}, last_ema_step={}".format(
        checkpoint["global_step"], len(ema), meta["last_ema_step"]
    )
)
' "$RAW_CHECKPOINT"

mkdir -p "$(dirname "$STAGED_CHECKPOINT")"
if [[ ! -s "$STAGED_CHECKPOINT" ]]; then
    temporary_staged="${STAGED_CHECKPOINT}.tmp-${SLURM_JOB_ID}"
    "$TRAIN_PYTHON_BIN" -m Evaluation.canonical_lejepa.stage_for_structtokenbench \
        "$RAW_CHECKPOINT" "$temporary_staged" --encoder-source=ema
    mv "$temporary_staged" "$STAGED_CHECKPOINT"
fi

"$TRAIN_PYTHON_BIN" -c '
import hashlib
import sys
import torch

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

source_path, staged_path = sys.argv[1:]
staged = torch.load(staged_path, map_location="cpu", weights_only=False)
provenance = staged.get("canonical_lejepa_evaluation", {})
assert provenance.get("encoder_source") == "ema", provenance
assert provenance.get("source_global_step") == 50_000, provenance
assert provenance.get("source_checkpoint_sha256") == sha256(source_path), provenance
print(f"Staged checkpoint provenance verified: {provenance}")
' "$RAW_CHECKPOINT" "$STAGED_CHECKPOINT"

sha256sum "$RAW_CHECKPOINT" "$STAGED_CHECKPOINT"
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export CANONICAL_LEJEPA_V1_EMA_STEP50K_CKPT="$STAGED_CHECKPOINT"
export EVALUATION_RUN_ID="slurm-${SLURM_JOB_ID}-canonical-lejepa-v1-ema-step50k-flexrmsf"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-canonical-lejepa-v1-ema-50k-rmsf-mpl-${SLURM_JOB_ID}"
export TRITON_CACHE_DIR="/tmp/stb-canonical-lejepa-v1-ema-50k-rmsf-triton-${SLURM_JOB_ID}"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=50k \
    --experiment=canonical-lejepa-v1-ema-step50k \
    --tasks=FlexRMSF
