#!/bin/bash
# Full 12-task locked StructTokenBench publication evaluations for the selected
# 100k JEPA/LeJEPA checkpoints.
# Usage: sbatch jobs/eval_publication_100k_selected_array.job
#SBATCH --job-name=stb_pub_100k
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --array=0-3
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

EXPERIMENTS=(
    jepa-mutation
    le-jepa-rand-mask-50
    le-jepa-rand-mask-70
    le-jepa-spatial3d-block-100k
)
CHECKPOINTS=(
    "$STB_ROOT/100k-checkpoints/jepa/mutation/100k.ckpt"
    "$STB_ROOT/100k-checkpoints/le-jepa/random_masking_50pct/100k.ckpt"
    "$STB_ROOT/100k-checkpoints/le-jepa/random_masking_70pct/100k.ckpt"
    "$STB_ROOT/100k-checkpoints/le-jepa/spatial3d_block_dim64_new_predictor/100k.ckpt"
)
CHECKPOINT_SHA256=(
    1db78106be46e4669bec2f04b1586af60f4e6e4b34a92dccc41a46ab70e199d4
    331013686490409271a0feadc8a10f6b347763191cb0a24dde348d5f7a970dc8
    d52e93cc7ccad0f9b127b510d0b2fa8d96ed41936072873491f2f20f2688d52c
    181235a2065374b2d6ae32c4279ca3c6bf840b8267d21b49e7691042c21202cf
)

EXPERIMENT="${EXPERIMENTS[$SLURM_ARRAY_TASK_ID]}"
CHECKPOINT="${CHECKPOINTS[$SLURM_ARRAY_TASK_ID]}"
EXPECTED_SHA256="${CHECKPOINT_SHA256[$SLURM_ARRAY_TASK_ID]}"

set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "main" ]]; then
    echo "ERROR: locked evaluation must run from main" >&2
    exit 1
fi

echo "$EXPECTED_SHA256  $CHECKPOINT" | sha256sum -c -
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

cd "$STB_ROOT"

export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-${EXPERIMENT}-100k"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-pub-100k-mpl-${SLURM_ARRAY_JOB_ID}-${SLURM_ARRAY_TASK_ID}"
export TRITON_CACHE_DIR="/tmp/stb-pub-100k-triton-${SLURM_ARRAY_JOB_ID}-${SLURM_ARRAY_TASK_ID}"

mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=100k \
    --experiment="$EXPERIMENT" \
    --tasks=all
