#!/bin/bash
# Extract final relative-position LeJEPA online latents and perform the exact
# matched 15k-residue t-SNE/absolute-index diagnostic.
#SBATCH --job-name=relpos_tsne
#SBATCH --partition=normal,h100
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=logs/le_jepa/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON=/slurm-storage/aishod/envs/la-proteina/bin/python

set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(hostname -s)" == "hopper" ]]; then
    export DATA_PATH="${DATA_PATH/\/mnt\/hopper-raid/\/mnt\/raid}"
fi

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT"
export MPLCONFIGDIR="/tmp/matplotlib-$SLURM_JOB_ID"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

srun "$PYTHON" Evaluation/latent_viz/analyze_lejepa_relative_positions.py
