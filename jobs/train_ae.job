#!/bin/bash
#SBATCH --job-name=laproteina_ae
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=12
#SBATCH --time=12:00:00
#SBATCH --output=logs/%x-%j.out

source ~/.bashrc

conda activate /data-gauss/$USER/envs/laproteina_env

cd ~/projects/la-proteina

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

srun python proteinfoundation/partial_autoencoder/train.py
