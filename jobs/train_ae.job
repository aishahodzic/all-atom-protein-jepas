#!/bin/bash
#SBATCH --job-name=laproteina_ae
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=24
#SBATCH --time=5:00:00
#SBATCH --output=logs/%x-%j.out

source ~/.bashrc

conda activate /data-gauss/$USER/envs/laproteina_env

cd ~/projects/la-proteina

python proteinfoundation/partial_autoencoder/train.py