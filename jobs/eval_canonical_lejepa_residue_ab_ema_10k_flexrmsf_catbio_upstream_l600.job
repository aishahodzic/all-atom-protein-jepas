#!/bin/bash
# Matched upstream-L600 FlexRMSF + CatBio probes for the two residue-level
# canonical LeJEPA attention modes. Submit against the matching training array:
#   sbatch --dependency=aftercorr:<TRAIN_ARRAY_JOB_ID> jobs/eval_canonical_lejepa_residue_ab_ema_10k_flexrmsf_catbio_upstream_l600.job
# Each element validates and stages only its corresponding 10k EMA encoder.
# The A/B tokenizer, shared-embedding-cache, result, and manifest identities are
# isolated, while the checkpoint-aware shared embedding cache remains enabled.
#SBATCH --job-name=stb_canon_res_ab_10k
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --array=0-1
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
TRAIN_PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

MODES=(iterative visible_only)
DISPLAY_MODES=(iterative visible-only)
RUN_NAMES=(
    canonical_lejepa_residue_iterative_10k
    canonical_lejepa_residue_visible_only_10k
)
EXPERIMENTS=(
    canonical-lejepa-residue-iterative-ema-step10k
    canonical-lejepa-residue-visible-only-ema-step10k
)
CHECKPOINT_ENV_VARS=(
    CANONICAL_LEJEPA_RESIDUE_ITERATIVE_EMA_STEP10K_CKPT
    CANONICAL_LEJEPA_RESIDUE_VISIBLE_ONLY_EMA_STEP10K_CKPT
)

MODE="${MODES[$SLURM_ARRAY_TASK_ID]}"
DISPLAY_MODE="${DISPLAY_MODES[$SLURM_ARRAY_TASK_ID]}"
RUN_NAME="${RUN_NAMES[$SLURM_ARRAY_TASK_ID]}"
EXPERIMENT="${EXPERIMENTS[$SLURM_ARRAY_TASK_ID]}"
CHECKPOINT_ENV_VAR="${CHECKPOINT_ENV_VARS[$SLURM_ARRAY_TASK_ID]}"
RUN_DIR="$PROJECT_ROOT/store/$RUN_NAME"
RAW_CHECKPOINT="$RUN_DIR/checkpoints/step-00010000.ckpt"
CANONICAL_CONFIG="$RUN_DIR/checkpoints/exp_config_${RUN_NAME}.json"
STAGED_CHECKPOINT="$RUN_DIR/evaluation/canonical-lejepa-residue-${DISPLAY_MODE}-step10000-ema-staged.ckpt"
STAGED_TMP="${STAGED_CHECKPOINT}.tmp-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"

cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "canonical-lejepa" ]]; then
    echo "ERROR: expected canonical-lejepa branch" >&2
    exit 1
fi

echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

"$TRAIN_PYTHON_BIN" -c '
import json
import sys
from collections.abc import Mapping

import torch

checkpoint_path, config_path, expected_mode = sys.argv[1:]
with open(config_path, encoding="utf-8") as handle:
    config = json.load(handle)
assert config.get("alignment_level") == "residue", config.get("alignment_level")
assert config.get("masked_kv_mode") == expected_mode, config.get("masked_kv_mode")
assert config.get("independent_view_rotations") is False, config.get("independent_view_rotations")

checkpoint = torch.load(
    checkpoint_path, map_location="cpu", weights_only=False, mmap=True
)
assert checkpoint.get("global_step") == 10_000, checkpoint.get("global_step")
ema = checkpoint.get("state_dict_ema")
assert isinstance(ema, Mapping) and len(ema) == 381, len(ema or {})
assert all(str(key).startswith("encoder.") for key in ema), "EMA contains non-encoder state"
ema_meta = checkpoint.get("state_dict_ema_meta", {})
assert ema_meta.get("num_updates") == 312, ema_meta
assert ema_meta.get("last_ema_step") == 9_984, ema_meta
print(
    f"Verified residue mode={expected_mode}, raw step=10000, and EMA state: "
    f"{ema_meta}"
)
' "$RAW_CHECKPOINT" "$CANONICAL_CONFIG" "$MODE"

mkdir -p "$(dirname "$STAGED_CHECKPOINT")"
trap 'rm -f -- "$STAGED_TMP"' EXIT
"$TRAIN_PYTHON_BIN" -m Evaluation.canonical_lejepa.stage_for_structtokenbench \
    "$RAW_CHECKPOINT" "$STAGED_TMP" --encoder-source=ema
mv -f -- "$STAGED_TMP" "$STAGED_CHECKPOINT"
trap - EXIT

"$TRAIN_PYTHON_BIN" -c '
import hashlib
import sys

import torch

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

raw_path, staged_path = sys.argv[1:]
raw_sha = sha256(raw_path)
staged = torch.load(staged_path, map_location="cpu", weights_only=False, mmap=True)
provenance = staged.get("canonical_lejepa_evaluation", {})
assert provenance.get("schema_version") == 1, provenance
assert provenance.get("encoder_source") == "ema", provenance
assert provenance.get("source_global_step") == 10_000, provenance
assert provenance.get("source_checkpoint_sha256") == raw_sha, provenance
assert provenance.get("latent_dim") == 8, provenance
assert provenance.get("projector") is None, provenance
state = staged.get("state_dict", {})
assert len(state) == 381, len(state)
assert all(str(key).startswith("online_encoder.") for key in state), (
    "staged artifact contains non-online-encoder state"
)
print(f"Verified atomic EMA staging and provenance: {provenance}")
' "$RAW_CHECKPOINT" "$STAGED_CHECKPOINT"

sha256sum "$RAW_CHECKPOINT" "$STAGED_CHECKPOINT"

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export "$CHECKPOINT_ENV_VAR=$STAGED_CHECKPOINT"
export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-${EXPERIMENT}-flexrmsf-catbio"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-${EXPERIMENT}-mpl-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
export TRITON_CACHE_DIR="/tmp/stb-${EXPERIMENT}-triton-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=10k \
    --experiment="$EXPERIMENT" \
    --tasks=FlexRMSF,CatBio
