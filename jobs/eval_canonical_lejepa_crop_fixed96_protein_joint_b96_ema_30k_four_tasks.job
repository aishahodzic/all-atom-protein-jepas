#!/bin/bash
# Four-task upstream-L600 evaluation of fixed-96/48 protein-level,
# joint-view SIGReg B96 EMA at source step 30,000.
#SBATCH --job-name=stb_joint30_4
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=05:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_crop_fixed96_protein_joint_sigreg_b96_10k/evaluation/canonical-lejepa-protein-cropped-fixed96-joint-sigreg-b96-step30000-ema-staged.ckpt"
EXPERIMENT=canonical-lejepa-protein-joint-b96-ema-step30k

test -f "$CHECKPOINT"
test -f "$ENCODER_CONFIG"

"$STB_PYTHON_BIN" -c '
import sys
import torch

checkpoint = torch.load(sys.argv[1], map_location="cpu", weights_only=False, mmap=True)
provenance = checkpoint.get("canonical_lejepa_evaluation", {})
assert provenance.get("source_global_step") == 30_000, provenance
assert provenance.get("encoder_source") == "ema", provenance
assert provenance.get("source_checkpoint_sha256") == "4a895be7e605ef5eff434a2e8c8c8f30cc1e2f682fab4bc26232155c580c11dc", provenance
state = checkpoint.get("state_dict", {})
online = [key for key in state if key.startswith("online_encoder.")]
assert len(online) == 381, len(online)
print("Verified 381 EMA encoder tensors from source step 30,000")
' "$CHECKPOINT"

echo "89763d5b80405706ec8d1071ebb415dd1ce30d99deb6ec5c44f36ba3cb11bb2b  $CHECKPOINT" | sha256sum -c -

cd "$STB_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export CANONICAL_LEJEPA_PROTEIN_JOINT_B96_EMA_STEP30K_CKPT="$CHECKPOINT"
export EVALUATION_RUN_ID="slurm-${SLURM_JOB_ID}-${EXPERIMENT}-four-stb"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="$HOME/tmp/stb-runtime-cache/${SLURM_JOB_ID}-joint30/mpl"
export TRITON_CACHE_DIR="$HOME/tmp/stb-runtime-cache/${SLURM_JOB_ID}-joint30/triton"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=30k \
    --experiment="$EXPERIMENT" \
    --tasks=Homo,CatBio,FlexRMSF,BindShake
