#!/bin/bash
# Matched cheap frozen-EMA residue-representation audit for the independent-
# local, protein-loss, fixed-96/48, per-view-SIGReg global-B96 checkpoint.
#SBATCH --job-name=diag_indlocal_repr_10k
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=00:15:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/canonical_lejepa/%x-%j.out

set -euo pipefail
PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PATH="/slurm-storage/aishod/envs/la-proteina/bin:$PATH"
export MPLCONFIGDIR="/tmp/${SLURM_JOB_NAME}-${SLURM_JOB_ID}"
export CANONICAL_RESIDUE_ANALYSIS_PROFILE=protein-perview-b96-independent-locals-cropped-fixed96-10k
mkdir -p "$MPLCONFIGDIR" "$PROJECT_ROOT/logs/canonical_lejepa"

srun --ntasks=1 "$PYTHON_BIN" \
    Evaluation/diagnostics/analyze_canonical_residue_ab_10k.py
