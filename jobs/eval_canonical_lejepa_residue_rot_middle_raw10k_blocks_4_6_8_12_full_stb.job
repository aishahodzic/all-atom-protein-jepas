#!/bin/bash
# Full publication-protocol STB evaluation of one-based post-block readouts
# from the cropped per-residue K=4 + independent-rotation raw step-10k encoder.
# Elements 0-3 run the 11 non-Homo tasks; elements 4-7 run Homo separately so
# its higher-memory preprocessing cannot interrupt the rest of a block panel.
# The array cap respects the four-GPU per-user allocation.
#SBATCH --job-name=stb_resrot10_depth
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodelist=noether
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --array=0-7%4
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
RUN_NAME=canonical_lejepa_crop_fixed96_residue_perview_sigreg_b96_independent_locals_k4_rotations_lr4e4_cosine_30k
CHECKPOINT="$PROJECT_ROOT/store/$RUN_NAME/evaluation/canonical-lejepa-residue-perview-rot-middle-lr-step10000-raw-staged.ckpt"
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
EXPECTED_CHECKPOINT_SHA256=a2937cdadc379deaec2be2fafe463440a7cc606cf3e1080580a2cddad5268733
EXPECTED_SOURCE_SHA256=999a3773bb2a6c00be8c16d5daf86dcf30c1577399434a6fe7a1bc70ea35f004
EXPECTED_ENCODER_CONFIG_SHA256=98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d
EXPERIMENT=canonical-lejepa-residue-perview-rot-middle-lr-raw-step10k
BLOCKS=(4 6 8 12)
BLOCK_INDEX=$((SLURM_ARRAY_TASK_ID % 4))
READOUT_BLOCK="${BLOCKS[$BLOCK_INDEX]}"

if (( SLURM_ARRAY_TASK_ID < 4 )); then
    TASK_GROUP=nonhomo
    TASKS=BindInt,BindBio,BindShake,CatInt,CatBio,Con,Rep,Ept,FlexRMSF,FlexBFactor,FlexNEQ
else
    TASK_GROUP=homo
    TASKS=Homo
fi

test -s "$CHECKPOINT"
test -s "$ENCODER_CONFIG"
echo "$EXPECTED_CHECKPOINT_SHA256  $CHECKPOINT" | sha256sum -c -
echo "$EXPECTED_ENCODER_CONFIG_SHA256  $ENCODER_CONFIG" | sha256sum -c -

"$STB_PYTHON_BIN" -c '
import sys
import torch

checkpoint_path, expected_source_sha, block = sys.argv[1:]
saved = torch.load(checkpoint_path, map_location="cpu", weights_only=False, mmap=True)
provenance = saved.get("canonical_lejepa_evaluation", {})
assert provenance.get("encoder_source") == "raw", provenance
assert provenance.get("source_global_step") == 10_000, provenance
assert provenance.get("source_checkpoint_sha256") == expected_source_sha, provenance
assert provenance.get("latent_dim") == 8, provenance
assert provenance.get("projector") is None, provenance
assert sum(str(key).startswith("online_encoder.") for key in saved.get("state_dict", {})) == 381
assert int(block) in (4, 6, 8, 12), block
print(f"Verified cropped per-residue raw step-10k encoder, post-block {block}: {provenance}")
' "$CHECKPOINT" "$EXPECTED_SOURCE_SHA256" "$READOUT_BLOCK"

RAID_DATA_ROOT=/mnt/hopper-raid/aishod/data
SHARED_CACHE_ROOT="$RAID_DATA_ROOT/struct_token_bench_release_data/shared_embedding_cache"
if [[ ! -d "$SHARED_CACHE_ROOT/v1" || ! -w "$SHARED_CACHE_ROOT" ]]; then
    echo "Hopper STB cache root is unavailable or not writable: $SHARED_CACHE_ROOT" >&2
    exit 1
fi

cd "$STB_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export STB_SHARED_EMBEDDING_CACHE_ROOT="$SHARED_CACHE_ROOT"
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=0
export PREFETCH_FACTOR=null
export STB_SERIAL_STRUCTURE_PREPROCESS=1
export NCCL_SHM_DISABLE=1
export TORCHINDUCTOR_COMPILE_THREADS=1
export DATA_PATH="$RAID_DATA_ROOT"
export PDB_DATA_ROOT="$RAID_DATA_ROOT/struct_token_bench_pdb_data"
export STB_RELEASE_DATA_ROOT="$RAID_DATA_ROOT/struct_token_bench_release_data"
export CANONICAL_LEJEPA_RESIDUE_PERVIEW_ROT_MIDDLE_LR_RAW_STEP10K_CKPT="$CHECKPOINT"
export TOKENIZER_READOUT_BLOCK="$READOUT_BLOCK"
export ENCODER_SOURCE=online
export D_MODEL_OVERRIDE=768
export WANDB_MODE=disabled
export HF_HUB_OFFLINE=1
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-${EXPERIMENT}-block${READOUT_BLOCK}-${TASK_GROUP}"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export TMPDIR="$HOME/tmp/stb-runtime-cache/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-resrot10-block${READOUT_BLOCK}-${TASK_GROUP}"
export MPLCONFIGDIR="$TMPDIR/matplotlib"
export TRITON_CACHE_DIR="$TMPDIR/triton"
export TORCH_EXTENSIONS_DIR="$TMPDIR/torch-extensions"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR" "$TORCH_EXTENSIONS_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=10k \
    --experiment="$EXPERIMENT" \
    --tasks="$TASKS"
