#!/bin/bash
# One-off diagnostic: reproduce the CatInt+AE1 "CUDA error: device-side
# assert triggered" failure with CUDA_LAUNCH_BLOCKING=1 and a tiny batch
# limit, to get a synchronous traceback instead of the deferred/uninformative
# async CUDA error the real run produced.
#SBATCH --job-name=ae1_catint_debug
#SBATCH --partition=normal
#SBATCH --nodelist=noether
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --time=0:30:00
#SBATCH --output=logs/%x-%j.out

set -a
source /mnt/data/slurm-storage/aishod/projects/la-proteina/.env
set +a

REPO_DIR="/mnt/data/slurm-storage/aishod/projects/la-proteina/StructTokenBench"
cd "$REPO_DIR"
export PYTHONPATH="$(dirname "$REPO_DIR")${PYTHONPATH:+:$PYTHONPATH}"
export DIR="$REPO_DIR"

source /slurm-storage/miniconda3/etc/profile.d/conda.sh
conda activate pstbench

CUDA_LAUNCH_BLOCKING=1 CUDA_VISIBLE_DEVICES=0 python ./src/script/run_supervised_task.py \
  --config-name=interpro.yaml tokenizer=WrappedLaProteinaTokenizer model.d_model=8 \
  trainer.devices=[0] optimization.optimizer.lr=0.001 data.target_field=activesite_label \
  data.num_workers=0 data.prefetch_factor=null \
  experiment_name=catint_ae1_gpu_debug run_name=gpu_debug \
  default_data_dir="$REPO_DIR/struct_token_bench_release_data/" \
  data.pdb_data_dir="$REPO_DIR/pdb_data/mmcif_files/" \
  trainer.default_root_dir="$REPO_DIR/struct_token_bench_logs/" \
  trainer.limit_train_batches=3 trainer.limit_val_batches=1 trainer.max_epochs=1 \
  tokenizer_pretrained_ckpt_path="/mnt/data/slurm-storage/aishod/projects/la-proteina/checkpoints_laproteina/AE1_ucond_512.ckpt" \
  tokenizer_checkpoint_type=ae
