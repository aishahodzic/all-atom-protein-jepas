#!/bin/bash
#SBATCH --job-name=ae_latent
#SBATCH --partition=hpc-mid
#SBATCH --account=cw-sup
#SBATCH --qos=normal
#SBATCH --nodes=1
#SBATCH --gres=gpu:8
#SBATCH --ntasks-per-node=8
#SBATCH --cpus-per-task=12
#SBATCH --time=12:00:00
#SBATCH --output=logs/%x-%j.out

set -euo pipefail

export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-/mnt/home/kdidi/.local/share/mamba}"
eval "$(/usr/local/bin/micromamba shell hook --shell bash)"
micromamba activate "${LAPROTEINA_ENV_NAME:-laproteina_env}"

cd /mnt/home/kdidi/projects/msc-thesis-jepa-latent

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export NCCL_P2P_DISABLE=1
export NCCL_SHM_DISABLE=1
export RESUME_CHOICE="${RESUME_CHOICE:-scratch}"

WANDB_USER_INFO="${WANDB_USER_INFO:-/mnt/home/kdidi/projects/foundry-dev/projects/proteinfoundation/slurm_utils/.user_info_coreweave}"
if [ -z "${WANDB_API_KEY:-}" ] && [ -f "$WANDB_USER_INFO" ]; then
    source "$WANDB_USER_INFO"
    export WANDB_API_KEY="${WANDBKEY:-}"
fi
export WANDB_MODE="${WANDB_MODE:-online}"

srun --kill-on-bad-exit=1 \
    python proteinfoundation/partial_autoencoder/train.py \
    --config-name training_ae_latent "$@"
