#!/bin/bash
# Full publication-protocol STB layer sweeps for the two cropped, no-rotation
# raw step-10k encoders: protein-level alignment and residue-level alignment.
# For each model, elements 0-3 run all non-Homo tasks and elements 4-7 run
# Homo separately.  The four-way cap respects the medium-QoS GPU limit.
#
# The original per-residue source used for the thesis table was removed after
# its final-latent evaluation.  This sweep therefore uses the independently
# trained, configuration-matched step-10k relaunch checkpoint and records that
# distinction in the experiment and output names.
#SBATCH --job-name=stb_crop_norot_depth
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodelist=noether
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --array=0-15%4
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
EXPECTED_ENCODER_CONFIG_SHA256=98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d

# Fail before any expensive setup if Slurm places the task on a node whose
# NVIDIA driver/NVML stack cannot initialize.  The first submission exposed
# this cluster fault on gauss and klein; noether is currently healthy.
nvidia-smi -L
"$STB_PYTHON_BIN" -c '
import torch

assert torch.cuda.is_available(), "CUDA is unavailable"
assert torch.cuda.device_count() == 1, torch.cuda.device_count()
device = torch.device("cuda:0")
probe = torch.ones(1, device=device)
print(f"CUDA preflight passed: {torch.cuda.get_device_name(device)} ({probe.item():.0f})")
'

MODEL_INDEX=$((SLURM_ARRAY_TASK_ID / 8))
MODEL_TASK_INDEX=$((SLURM_ARRAY_TASK_ID % 8))
BLOCKS=(4 6 8 12)
READOUT_BLOCK="${BLOCKS[$((MODEL_TASK_INDEX % 4))]}"

EXPERIMENTS=(
    canonical-lejepa-middle-lr4e4-raw-step10k
    canonical-lejepa-residue-perview-b96-relaunch-raw-step10k
)
MODEL_LABELS=(
    crop-protein-norot
    crop-residue-norot-relaunch
)
CHECKPOINTS=(
    "$STB_ROOT/100k-checkpoints/canonical-lejepa/lr-ablation/canonical_lejepa_protein_middle_lr4e4_raw10k_stb.ckpt"
    "$PROJECT_ROOT/store/canonical_lejepa_crop_fixed96_residue_perview_sigreg_b96_100k_relaunch/evaluation/canonical-lejepa-residue-perview-b96-relaunch-step10000-raw-staged.ckpt"
)
EXPECTED_STAGED_SHA256=(
    61efd8bc9e2010792a4c6b76c2576e26d765d97d7c7c2eb0263725c0af77107d
    781107febead25c3abd17fe2cce9f23e51a648ceb740e0487c101a0e6c3a95e3
)
EXPECTED_SOURCE_SHA256=(
    c9a7b99204a2ba6324bd4052a3682082354740b8cbef9872c7d8f2bb18c6541c
    639a11a9dc84692ebe477cc09ee8c63eb781a546f1187158fd6792a226be1ce6
)

EXPERIMENT="${EXPERIMENTS[$MODEL_INDEX]}"
MODEL_LABEL="${MODEL_LABELS[$MODEL_INDEX]}"
CHECKPOINT="${CHECKPOINTS[$MODEL_INDEX]}"
EXPECTED_STAGED_SHA="${EXPECTED_STAGED_SHA256[$MODEL_INDEX]}"
EXPECTED_SOURCE_SHA="${EXPECTED_SOURCE_SHA256[$MODEL_INDEX]}"

if (( MODEL_TASK_INDEX < 4 )); then
    TASK_GROUP=nonhomo
    TASKS=BindInt,BindBio,BindShake,CatInt,CatBio,Con,Rep,Ept,FlexRMSF,FlexBFactor,FlexNEQ
else
    TASK_GROUP=homo
    TASKS=Homo
fi

test -s "$CHECKPOINT"
test -s "$ENCODER_CONFIG"
echo "$EXPECTED_STAGED_SHA  $CHECKPOINT" | sha256sum -c -
echo "$EXPECTED_ENCODER_CONFIG_SHA256  $ENCODER_CONFIG" | sha256sum -c -

"$STB_PYTHON_BIN" -c '
import sys
import torch

checkpoint_path, expected_source_sha, block = sys.argv[1:]
saved = torch.load(checkpoint_path, map_location="cpu", weights_only=False, mmap=True)
provenance = saved.get("canonical_lejepa_evaluation", {})
assert provenance.get("encoder_source") == "raw", provenance
assert provenance.get("source_global_step") == 10_000, provenance
assert provenance.get("source_checkpoint_sha256") == expected_source_sha, provenance
assert provenance.get("latent_dim") == 8, provenance
assert provenance.get("projector") is None, provenance
assert sum(str(key).startswith("online_encoder.") for key in saved.get("state_dict", {})) == 381
assert int(block) in (4, 6, 8, 12), block
print(f"Verified cropped no-rotation raw step-10k encoder, post-block {block}: {provenance}")
' "$CHECKPOINT" "$EXPECTED_SOURCE_SHA" "$READOUT_BLOCK"

RAID_DATA_ROOT=/mnt/hopper-raid/aishod/data
SHARED_CACHE_ROOT="$RAID_DATA_ROOT/struct_token_bench_release_data/shared_embedding_cache"
if [[ ! -d "$SHARED_CACHE_ROOT/v1" || ! -w "$SHARED_CACHE_ROOT" ]]; then
    echo "Hopper STB cache root is unavailable or not writable: $SHARED_CACHE_ROOT" >&2
    exit 1
fi

cd "$STB_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
# Allow storage-constrained relaunches to disable the duplicate cross-task
# embedding layer while retaining STB's authoritative task-specific caches.
export STB_SHARED_EMBEDDING_CACHE="${STB_SHARED_EMBEDDING_CACHE:-1}"
export STB_SHARED_EMBEDDING_CACHE_ROOT="$SHARED_CACHE_ROOT"
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=0
export PREFETCH_FACTOR=null
export STB_SERIAL_STRUCTURE_PREPROCESS=1
export NCCL_SHM_DISABLE=1
export TORCHINDUCTOR_COMPILE_THREADS=1
export DATA_PATH="$RAID_DATA_ROOT"
export PDB_DATA_ROOT="$RAID_DATA_ROOT/struct_token_bench_pdb_data"
export STB_RELEASE_DATA_ROOT="$RAID_DATA_ROOT/struct_token_bench_release_data"
export CANONICAL_LEJEPA_RESIDUE_PERVIEW_B96_RELAUNCH_RAW_STEP10K_CKPT="${CHECKPOINTS[1]}"
export TOKENIZER_READOUT_BLOCK="$READOUT_BLOCK"
export ENCODER_SOURCE=online
export D_MODEL_OVERRIDE=768
export WANDB_MODE=disabled
export HF_HUB_OFFLINE=1
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-${MODEL_LABEL}-raw-step10k-block${READOUT_BLOCK}-${TASK_GROUP}"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export TMPDIR="$HOME/tmp/stb-runtime-cache/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-${MODEL_LABEL}-block${READOUT_BLOCK}-${TASK_GROUP}"
export MPLCONFIGDIR="$TMPDIR/matplotlib"
export TRITON_CACHE_DIR="$TMPDIR/triton"
export TORCH_EXTENSIONS_DIR="$TMPDIR/torch-extensions"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR" "$TORCH_EXTENSIONS_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=10k \
    --experiment="$EXPERIMENT" \
    --tasks="$TASKS"
