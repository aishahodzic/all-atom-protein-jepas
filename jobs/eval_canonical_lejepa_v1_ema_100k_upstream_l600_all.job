#!/bin/bash
# Full locked upstream-L600 StructTokenBench evaluation of canonical LeJEPA V1's
# immutable step-100k EMA encoder. The job stages a loader-compatible artifact
# and verifies its provenance before running all twelve tasks.
#SBATCH --job-name=stb_canon_lj_100k_all
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
TRAIN_PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
RAW_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_v1_100k/checkpoints/step-00100000.ckpt"
STAGED_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_v1_100k/evaluation/canonical-lejepa-v1-step100000-ema-staged.ckpt"
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
EXPECTED_RAW_SHA256=4f09dff610adaa75c8ac51b4cf01acb001c236c72dd91ac31568ffa191484527

set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "canonical-lejepa" ]]; then
    echo "ERROR: expected canonical-lejepa branch" >&2
    exit 1
fi

echo "$EXPECTED_RAW_SHA256  $RAW_CHECKPOINT" | sha256sum -c -
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

if [[ ! -f "$STAGED_CHECKPOINT" ]]; then
    STAGED_TMP="${STAGED_CHECKPOINT}.tmp-${SLURM_JOB_ID}"
    "$TRAIN_PYTHON_BIN" -m Evaluation.canonical_lejepa.stage_for_structtokenbench \
        "$RAW_CHECKPOINT" "$STAGED_TMP" --encoder-source=ema
    mv "$STAGED_TMP" "$STAGED_CHECKPOINT"
fi

"$TRAIN_PYTHON_BIN" -c '
import hashlib
import sys
import torch

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

raw_path, staged_path, expected_sha = sys.argv[1:]
raw = torch.load(raw_path, map_location="cpu", weights_only=False, mmap=True)
assert raw.get("global_step") == 100_000, raw.get("global_step")
ema = raw.get("state_dict_ema")
assert isinstance(ema, dict) and len(ema) == 381, len(ema or {})
ema_meta = raw.get("state_dict_ema_meta", {})
assert ema_meta.get("num_updates") == 3_125, ema_meta
assert ema_meta.get("last_ema_step") == 100_000, ema_meta

raw_sha = sha256(raw_path)
assert raw_sha == expected_sha, raw_sha
staged = torch.load(staged_path, map_location="cpu", weights_only=False, mmap=True)
provenance = staged.get("canonical_lejepa_evaluation", {})
assert provenance.get("encoder_source") == "ema", provenance
assert provenance.get("source_global_step") == 100_000, provenance
assert provenance.get("source_checkpoint_sha256") == raw_sha, provenance
assert provenance.get("latent_dim") == 8, provenance
assert provenance.get("projector") is None, provenance
print(f"Verified canonical step-100k EMA staging: {provenance}")
' "$RAW_CHECKPOINT" "$STAGED_CHECKPOINT" "$EXPECTED_RAW_SHA256"

sha256sum "$STAGED_CHECKPOINT"

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export CANONICAL_LEJEPA_V1_EMA_STEP100K_CKPT="$STAGED_CHECKPOINT"
export EVALUATION_RUN_ID="slurm-${SLURM_JOB_ID}-canonical-lejepa-v1-ema-step100k-all"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-canonical-lejepa-v1-ema-100k-all-mpl-${SLURM_JOB_ID}"
export TRITON_CACHE_DIR="/tmp/stb-canonical-lejepa-v1-ema-100k-all-triton-${SLURM_JOB_ID}"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=100k \
    --experiment=canonical-lejepa-v1-ema-step100k \
    --tasks=all
