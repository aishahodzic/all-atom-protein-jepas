#!/bin/bash
#SBATCH --job-name=prepare_laproteina
#SBATCH --partition=hpc-mid
#SBATCH --account=cw-sup
#SBATCH --qos=normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=256G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x-%j.out

set -euo pipefail

export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-/mnt/home/kdidi/.local/share/mamba}"
eval "$(/usr/local/bin/micromamba shell hook --shell bash)"
micromamba activate "${LAPROTEINA_ENV_NAME:-laproteina_env}"

cd /mnt/home/kdidi/projects/msc-thesis-jepa-latent

python script_utils/prepare_pdb_data.py
