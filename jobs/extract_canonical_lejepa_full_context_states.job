#!/bin/bash
#SBATCH --job-name=canon_lj_fullctx
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/canonical_lejepa/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python

cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export MPLCONFIGDIR="/tmp/canonical-full-context-${SLURM_JOB_ID}"
mkdir -p "$MPLCONFIGDIR" "$PROJECT_ROOT/logs/canonical_lejepa"

srun "$PYTHON_BIN" -m unittest \
    Evaluation.canonical_lejepa.test_full_context_layer_states
srun "$PYTHON_BIN" -m Evaluation.canonical_lejepa.extract_full_context_layer_states \
    --stages tests,smoke,pilot,full \
    --device cuda
