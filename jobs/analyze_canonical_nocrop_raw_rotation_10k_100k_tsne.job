#!/bin/bash
# Matched no-crop raw 10k/100k x independent-view-rotation t-SNE audit.
#SBATCH --job-name=tsne_nocrop_raw_rot
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=00:15:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/canonical_lejepa/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PATH="/slurm-storage/aishod/envs/la-proteina/bin:$PATH"
export MPLCONFIGDIR="$HOME/tmp/canonical-nocrop-raw-tsne/${SLURM_JOB_ID}/mpl"
export TRITON_CACHE_DIR="$HOME/tmp/canonical-nocrop-raw-tsne/${SLURM_JOB_ID}/triton"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
mkdir -p "$MPLCONFIGDIR" "$TRITON_CACHE_DIR" "$PROJECT_ROOT/logs/canonical_lejepa"

srun --ntasks=1 "$PYTHON_BIN" \
    Evaluation/latent_viz/analyze_canonical_nocrop_raw_rotation_10k_100k.py
