#!/bin/bash
# For the 9 tasks that need /mnt/hopper-raid (bindint, bindbio, bindshake, catint,
# catbio, con, rep, ept, homo) -- pinned to noether, which has that mount; gauss/klein
# don't. See run_eval.sh's TASK_EXTRA_ARGS: everything except flexrmsf/flexbfactor/flexneq.
#
# Usage: sbatch jobs/struct_token_bench_eval_noether.job --checkpoint=100k --experiment=all --tasks=all
# (any run_eval.sh flag works here, passed straight through)
#SBATCH --job-name=struct_token_bench_eval_noether
#SBATCH --partition=h100
#SBATCH --nodelist=hopper
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00
#SBATCH --output=logs/%x-%j.out

# run_eval.sh never touches DATA_PATH itself -- it expects the caller to have it set
# (confirmed: no DATA_PATH/.env references anywhere in the script).
set -a
source /mnt/data/slurm-storage/aishod/projects/la-proteina/.env
set +a

# hopper uses /mnt/raid locally, other nodes use /mnt/hopper-raid over NFS -- same
# rewrite the other job scripts use. This job was noether-only originally (hence
# the name); needed once it can also run on hopper (see run_eval.sh's own
# PDB_DATA_ROOT hostname check, which already handles this for the mmCIF corpus --
# DATA_PATH itself didn't, and WrappedLaProteinaTokenizer reads DATA_PATH directly
# for the pdb_train pretrained-cache lookup).
if [ "$(hostname -s)" = "hopper" ]; then
    export DATA_PATH="${DATA_PATH/\/mnt\/hopper-raid/\/mnt\/raid}"
fi

cd /mnt/data/slurm-storage/aishod/projects/la-proteina/StructTokenBench
bash src/script/run_eval.sh "$@"
