#!/bin/bash
#SBATCH --job-name=le_jepa_mut_v1
#SBATCH --partition=h100
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00
#SBATCH --output=logs/%x-%j.out

# conda init via ~/.bashrc doesn't work in batch jobs
source /slurm-storage/miniconda3/etc/profile.d/conda.sh
conda activate /slurm-storage/aishod/envs/la-proteina

# /data-gauss is dead, use /tmp
export TMPDIR=/tmp

# load DATA_PATH / HF_TOKEN from repo .env
set -a
source /mnt/data/slurm-storage/aishod/projects/la-proteina/.env
set +a

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# so `import proteinfoundation` resolves from any cwd
export PYTHONPATH=/mnt/data/slurm-storage/aishod/projects/la-proteina:$PYTHONPATH

# hopper uses /mnt/raid locally, other nodes use /mnt/hopper-raid over NFS
if [ "$(hostname -s)" = "hopper" ]; then
    export DATA_PATH="${DATA_PATH/\/mnt\/hopper-raid/\/mnt\/raid}"
    RAID_ROOT=/mnt/raid/aishod
else
    RAID_ROOT=/mnt/hopper-raid/aishod
fi

mkdir -p "$RAID_ROOT/runs/le_jepa_mut_v1"
cd "$RAID_ROOT/runs/le_jepa_mut_v1"

# "last" answers train.py's resume-from-checkpoint prompt
# flags: +single=true (1 GPU), dataset.datamodule.num_workers=16,
# +use_action_conditioning=true (turns on mutation conditioning)
echo "last" | srun python /mnt/data/slurm-storage/aishod/projects/la-proteina/proteinfoundation/jepa/train.py \
    run_name_=le_jepa_mut_v1 +single=true dataset.datamodule.num_workers=16 +use_action_conditioning=true
