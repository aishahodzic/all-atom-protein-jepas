#!/bin/bash
# Full locked upstream-L600 StructTokenBench evaluation of the raw step-100k
# encoders for canonical LeJEPA V1, without and with view rotations.
#SBATCH --job-name=stb_canon_raw100k
#SBATCH --partition=normal
#SBATCH --qos=medium
# noether passed a direct CUDA/NVML check; gauss and klein currently report a
# driver/library mismatch for the training environment.
#SBATCH --nodelist=noether
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --array=0-1%2
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
TRAIN_PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
EXPECTED_ENCODER_CONFIG_SHA256=98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d

case "$SLURM_ARRAY_TASK_ID" in
    0)
        EXPERIMENT=canonical-lejepa-v1-raw-step100k
        SOURCE_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_v1_100k/checkpoints/step-00100000.ckpt"
        SOURCE_CONFIG="$PROJECT_ROOT/store/canonical_lejepa_v1_100k/checkpoints/exp_config_canonical_lejepa_v1_100k.json"
        STAGED_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_v1_100k/evaluation/canonical-lejepa-v1-step100000-raw-staged.ckpt"
        EXPECTED_SOURCE_SHA256=4f09dff610adaa75c8ac51b4cf01acb001c236c72dd91ac31568ffa191484527
        EXPECTED_STAGED_SHA256=28f93a4224323b7366243265abd7721f2dffaaf6f8c9fd4aa4767788fd5d2bac
        EXPECT_ROTATIONS=false
        ;;
    1)
        EXPERIMENT=canonical-lejepa-v1-rotations-raw-step100k
        SOURCE_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_rotations_100k/checkpoints/step-00100000.ckpt"
        SOURCE_CONFIG="$PROJECT_ROOT/store/canonical_lejepa_rotations_100k/checkpoints/exp_config_canonical_lejepa_rotations_100k.json"
        STAGED_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_rotations_100k/evaluation/canonical-lejepa-v1-rotations-step100000-raw-staged.ckpt"
        EXPECTED_SOURCE_SHA256=aa31110b2fafae5e414840286c05cbfa78170fac51c8ff8018d9a038a621b82c
        EXPECTED_STAGED_SHA256=3c0c56ec16e22386684b2bcdc54c1001ab160507ec99d50828c7de2e3b87b343
        EXPECT_ROTATIONS=true
        ;;
    *)
        echo "Unexpected SLURM_ARRAY_TASK_ID=$SLURM_ARRAY_TASK_ID" >&2
        exit 1
        ;;
esac

cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(git branch --show-current)" != "canonical-lejepa" ]]; then
    echo "ERROR: expected canonical-lejepa branch" >&2
    exit 1
fi

echo "$EXPECTED_SOURCE_SHA256  $SOURCE_CHECKPOINT" | sha256sum -c -
echo "$EXPECTED_ENCODER_CONFIG_SHA256  $ENCODER_CONFIG" | sha256sum -c -

if [[ ! -s "$STAGED_CHECKPOINT" ]]; then
    staged_tmp="${STAGED_CHECKPOINT}.tmp-${SLURM_ARRAY_JOB_ID}-${SLURM_ARRAY_TASK_ID}"
    "$TRAIN_PYTHON_BIN" -m Evaluation.canonical_lejepa.stage_for_structtokenbench \
        "$SOURCE_CHECKPOINT" "$staged_tmp" --encoder-source=raw
    mv "$staged_tmp" "$STAGED_CHECKPOINT"
fi

echo "$EXPECTED_STAGED_SHA256  $STAGED_CHECKPOINT" | sha256sum -c -

"$TRAIN_PYTHON_BIN" -c '
import json
import sys
import torch

source_path, staged_path, config_path, expected_sha, expected_rotations = sys.argv[1:]
with open(config_path, encoding="utf-8") as handle:
    config = json.load(handle)
assert bool(config.get("independent_view_rotations", False)) is (expected_rotations == "true")
source = torch.load(source_path, map_location="cpu", weights_only=False, mmap=True)
assert source.get("global_step") == 100_000, source.get("global_step")
raw_encoder = {
    key: value for key, value in source.get("state_dict", {}).items()
    if key.startswith("encoder.")
}
assert len(raw_encoder) == 381, len(raw_encoder)
staged = torch.load(staged_path, map_location="cpu", weights_only=False, mmap=True)
provenance = staged.get("canonical_lejepa_evaluation", {})
assert provenance.get("encoder_source") == "raw", provenance
assert provenance.get("source_global_step") == 100_000, provenance
assert provenance.get("source_checkpoint_sha256") == expected_sha, provenance
assert provenance.get("latent_dim") == 8, provenance
assert provenance.get("projector") is None, provenance
print(f"Verified raw step-100k staging: {provenance}")
' "$SOURCE_CHECKPOINT" "$STAGED_CHECKPOINT" "$SOURCE_CONFIG" "$EXPECTED_SOURCE_SHA256" "$EXPECT_ROTATIONS"

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data

if [[ "$SLURM_ARRAY_TASK_ID" == 0 ]]; then
    export CANONICAL_LEJEPA_V1_RAW_STEP100K_CKPT="$STAGED_CHECKPOINT"
else
    export CANONICAL_LEJEPA_V1_ROTATIONS_RAW_STEP100K_CKPT="$STAGED_CHECKPOINT"
fi

export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-${EXPERIMENT}-all"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="$STB_LOG_ROOT/cache/matplotlib"
export TRITON_CACHE_DIR="$STB_LOG_ROOT/cache/triton"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=100k \
    --experiment="$EXPERIMENT" \
    --tasks=all
