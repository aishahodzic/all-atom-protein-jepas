#!/bin/bash
# Matched upstream-L600 FlexRMSF probes for the 10k/30k/50k EMA encoders
# from canonical LeJEPA V1 trained with independent SO(3) rotations per view.
# Submit after the matched t-SNE job with:
#   sbatch --dependency=afterok:<TSNE_JOB_ID> jobs/eval_canonical_lejepa_rotations_ema_10k_30k_50k_flexrmsf_upstream_l600.job
#SBATCH --job-name=stb_canon_rot_135_rmsf
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --array=0-2
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
TRAIN_PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
ROTATION_CONFIG="$PROJECT_ROOT/store/canonical_lejepa_rotations_100k/checkpoints/exp_config_canonical_lejepa_rotations_100k.json"

STEPS=(10000 30000 50000)
LABELS=(10k 30k 50k)
STEP="${STEPS[$SLURM_ARRAY_TASK_ID]}"
LABEL="${LABELS[$SLURM_ARRAY_TASK_ID]}"
RAW_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_rotations_100k/checkpoints/step-$(printf '%08d' "$STEP").ckpt"
STAGED_CHECKPOINT="$PROJECT_ROOT/store/canonical_lejepa_rotations_100k/evaluation/canonical-lejepa-v1-rotations-step${STEP}-ema-staged.ckpt"

set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(git -C "$PROJECT_ROOT" branch --show-current)" != "canonical-lejepa" ]]; then
    echo "ERROR: expected canonical-lejepa branch" >&2
    exit 1
fi

"$TRAIN_PYTHON_BIN" -c '
import json
import sys
import torch

checkpoint_path, config_path, expected_step = sys.argv[1], sys.argv[2], int(sys.argv[3])
with open(config_path, encoding="utf-8") as handle:
    config = json.load(handle)
assert config.get("independent_view_rotations") is True, config.get("independent_view_rotations")
checkpoint = torch.load(checkpoint_path, map_location="cpu", weights_only=False)
assert checkpoint.get("global_step") == expected_step, checkpoint.get("global_step")
ema = checkpoint.get("state_dict_ema")
assert isinstance(ema, dict) and len(ema) > 0
expected_last_ema_step = (expected_step // 32) * 32
assert checkpoint.get("state_dict_ema_meta", {}).get("last_ema_step") == expected_last_ema_step
print(
    f"Verified independent-rotation source step={expected_step}, "
    f"EMA tensors={len(ema)}, last_ema_step={expected_last_ema_step}"
)
' "$RAW_CHECKPOINT" "$ROTATION_CONFIG" "$STEP"

mkdir -p "$(dirname "$STAGED_CHECKPOINT")"
if [[ ! -s "$STAGED_CHECKPOINT" ]]; then
    temporary_staged="${STAGED_CHECKPOINT}.tmp-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
    "$TRAIN_PYTHON_BIN" -m Evaluation.canonical_lejepa.stage_for_structtokenbench \
        "$RAW_CHECKPOINT" "$temporary_staged" --encoder-source=ema
    mv "$temporary_staged" "$STAGED_CHECKPOINT"
fi

"$TRAIN_PYTHON_BIN" -c '
import hashlib
import sys
import torch

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

raw_path, staged_path, expected_step = sys.argv[1], sys.argv[2], int(sys.argv[3])
staged = torch.load(staged_path, map_location="cpu", weights_only=False)
provenance = staged.get("canonical_lejepa_evaluation", {})
assert provenance.get("encoder_source") == "ema", provenance
assert provenance.get("source_global_step") == expected_step, provenance
assert provenance.get("source_checkpoint_sha256") == sha256(raw_path), provenance
print(f"Verified staged independent-rotation EMA provenance: {provenance}")
' "$RAW_CHECKPOINT" "$STAGED_CHECKPOINT" "$STEP"

echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export "CANONICAL_LEJEPA_V1_ROTATIONS_EMA_STEP${LABEL^^}_CKPT=$STAGED_CHECKPOINT"
export EVALUATION_RUN_ID="slurm-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}-canonical-lejepa-v1-rotations-ema-step${LABEL}-flexrmsf"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export MPLCONFIGDIR="/tmp/stb-canonical-lejepa-v1-rotations-ema-${LABEL}-rmsf-mpl-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
export TRITON_CACHE_DIR="/tmp/stb-canonical-lejepa-v1-rotations-ema-${LABEL}-rmsf-triton-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "$STB_LOG_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint="$LABEL" \
    --experiment="canonical-lejepa-v1-rotations-ema-step${LABEL}" \
    --tasks=FlexRMSF
