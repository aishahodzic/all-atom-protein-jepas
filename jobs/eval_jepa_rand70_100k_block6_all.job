#!/bin/bash
# Full 12-task layerwise (post-block-6) STB panel for plain JEPA rand-70.
# No SIGReg, no relative-position objective, no EMA target -- the plainest
# member of this backbone family, used to check whether the "mid-layer beats
# final 8D latent on flex tasks" pattern seen for canonical-lejepa is a
# general property of the shared 12-layer/768-dim backbone or specific to
# canonical-lejepa's own training recipe.
#SBATCH --job-name=stb_jepa_r70_b6
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodelist=noether
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
CHECKPOINT="$STB_ROOT/100k-checkpoints/jepa/random_masking_70pct/100k.ckpt"
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"

set -a
source "$PROJECT_ROOT/.env"
set +a

echo "63183c74a02386fdc9aaca3ff619e9f8e83705a79340610b1f4a064ba547098c  $CHECKPOINT" | sha256sum -c -
echo "98e0350d418e7d840fa245ddfd7150064e87a9ac74c72c9150a946f0f66ccd9d  $ENCODER_CONFIG" | sha256sum -c -

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export STB_SHARED_EMBEDDING_CACHE_ROOT="${STB_SHARED_EMBEDDING_CACHE_ROOT:-$PROJECT_ROOT/store/jepa_rand70_100k/evaluation/stb_layerwise_shared_cache}"
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN
export NUM_WORKERS="${NUM_WORKERS:-8}"
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export TOKENIZER_READOUT_BLOCK=6
export D_MODEL_OVERRIDE=768
export EVALUATION_RUN_ID="slurm-${SLURM_JOB_ID}-jepa-rand-mask-70-block6-panel"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export TMPDIR="$HOME/tmp/stb-jepa-r70-b6-panel/${SLURM_JOB_ID}"
export MPLCONFIGDIR="$TMPDIR/mpl"
export TRITON_CACHE_DIR="$TMPDIR/triton"
mkdir -p "$STB_LOG_ROOT" "$STB_SHARED_EMBEDDING_CACHE_ROOT" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=100k \
    --experiment=jepa-rand-mask-70 \
    --tasks="${TASKS_OVERRIDE:-all}"
