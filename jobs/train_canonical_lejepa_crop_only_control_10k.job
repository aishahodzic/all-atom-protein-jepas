#!/bin/bash
# Matched crop-only control. Both array arms use the same min-96 cohort,
# protein-level objective, per-view SIGReg, masking, global batch, optimiser,
# schedule and 10k stopping point. The sole scientific switch is cropping.
#SBATCH --job-name=canon_crop_ctrl_10k
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --nodes=1
#SBATCH --ntasks=2
#SBATCH --ntasks-per-node=2
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=03:00:00
#SBATCH --array=0-1
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/canonical_lejepa/%x-%A_%a.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python

case "${SLURM_ARRAY_TASK_ID}" in
    0)
        RUN_NAME=canonical_lejepa_crop_control_uncropped_local80_min96_b16_nw0_10k
        CROPPING=false
        ;;
    1)
        RUN_NAME=canonical_lejepa_crop_control_fixed96_local80_min96_b16_nw0_10k
        CROPPING=true
        ;;
    *)
        echo "Unexpected array index: ${SLURM_ARRAY_TASK_ID}" >&2
        exit 2
        ;;
esac

cd "$PROJECT_ROOT"
set -a
source "$PROJECT_ROOT/.env"
set +a

export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PATH="/slurm-storage/aishod/envs/la-proteina/bin:$PATH"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export MASTER_ADDR=127.0.0.1
export MASTER_PORT=$((20000 + SLURM_JOB_ID % 20000))
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export HYDRA_FULL_ERROR=1
export TMPDIR="$HOME/tmp/canonical-lejepa-crop-control/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
export MPLCONFIGDIR="$TMPDIR/matplotlib"
export TRITON_CACHE_DIR="$TMPDIR/triton"
mkdir -p "$TMPDIR" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR" "$PROJECT_ROOT/logs/canonical_lejepa"

srun --ntasks=2 --kill-on-bad-exit=1 --wait=30 --label "$PYTHON_BIN" \
    -m proteinfoundation.jepa.train_canonical_lejepa \
    run_name_="$RUN_NAME" seed=42 alignment_level=protein \
    masked_kv_mode=visible_only residue_view_checkpointing=false \
    residue_compact_visible_kv=false independent_view_rotations=false \
    views.cropping="$CROPPING" views.packed_views=true \
    views.global_crop_length=96 views.global_crop_fraction_min=null \
    views.global_crop_fraction_max=null views.global_crop_min_length=96 \
    views.global_crop_max_length=null views.local_crop_length=48 \
    views.locals_within_global=true views.shared_crop_anchor=false \
    views.global_mask_pct=0.20 views.local_mask_pct=0.80 \
    sigreg.input=protein_mean sigreg.joint_views=false \
    dataset.datamodule.dataselector.min_length=96 \
    dataset.datamodule.batch_size=8 dataset.datamodule.num_workers=0 \
    trainer.devices=2 trainer.num_nodes=1 \
    trainer.strategy=ddp trainer.use_distributed_sampler=false \
    trainer.precision=bf16-mixed trainer.accumulate_grad_batches=1 \
    trainer.max_steps=10000 schedule.total_steps=100000 schedule.peak_step=12000 \
    schedule.start_lr=1.0e-4 schedule.end_lr=4.0e-4 ema.enabled=true \
    checkpoint.every_n_train_steps=10000 \
    checkpoint.last_every_n_train_steps=1500 checkpoint.save_last=true \
    checkpoint.save_weights_only=false
