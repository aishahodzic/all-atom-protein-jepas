#!/bin/bash
#SBATCH --job-name=canonical_sigreg_nccl
#SBATCH --partition=normal
#SBATCH --qos=short
#SBATCH --nodelist=noether
#SBATCH --gres=gpu:2
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:10:00
#SBATCH --output=logs/canonical_lejepa/canonical_sigreg_nccl-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

srun "$PYTHON_BIN" -m torch.distributed.run \
    --standalone \
    --nproc-per-node=2 \
    -m proteinfoundation.jepa.tests.run_canonical_sigreg_nccl
