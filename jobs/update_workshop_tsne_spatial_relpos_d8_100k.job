#!/bin/bash
# Extract the final spatial-relative D8 encoder and refresh matched workshop t-SNE panels.
#SBATCH --job-name=workshop_tsne_sprel100k
#SBATCH --partition=normal,h100
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/diagnostics/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON=/slurm-storage/aishod/envs/la-proteina/bin/python

set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(hostname -s)" == "hopper" ]]; then
    export DATA_PATH="${DATA_PATH/\/mnt\/hopper-raid/\/mnt\/raid}"
fi

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT"
export MPLCONFIGDIR="/tmp/workshop-tsne-$SLURM_JOB_ID"
mkdir -p logs/diagnostics "$MPLCONFIGDIR"

srun "$PYTHON" Evaluation/latent_viz/plot_requested_100k_comparisons.py --extract-spatial
cp Evaluation/latent_viz/figures/tsne_aa20_requested-full-12model-100k_grid.png \
    Evaluation/latent_viz/figures/workshop/tsne_aa20_full-12model-100k.png
cp Evaluation/latent_viz/figures/tsne_aa20_requested-reduced-6model-100k_grid.png \
    Evaluation/latent_viz/figures/workshop/tsne_aa20_reduced-6model-100k.png
