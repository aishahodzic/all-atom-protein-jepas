#!/bin/bash
# Continue the matched C-alpha-conditioned reconstruction decoder from its
# exact step-140k weights to the same 200k budget as the JEPA rand-70 decoder.
# Decoder checkpoints store weights only, so AdamW restarts on continuation,
# as it does for the matched JEPA run.
#SBATCH --job-name=dec_cac_200k
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=100G
#SBATCH --time=10:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/decoder/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/data-gauss/$USER/envs/laproteina_env/bin/python3
SOURCE_RUN_ID=ca-cond-100k-ema-decoder-140k
RUN_ID=ca-cond-100k-ema-decoder-140k-to-200k
RESUME_STEP=140000
RESUME_CKPT="$PROJECT_ROOT/Evaluation/structure_rec/checkpoints/${SOURCE_RUN_ID}_step${RESUME_STEP}.pt"
SCRATCH_ROOT="$HOME/tmp/decoder-ca-cond-200k-$SLURM_JOB_ID"

[[ -s "$RESUME_CKPT" ]] || { echo "ERROR: missing exact step-140k decoder checkpoint: $RESUME_CKPT" >&2; exit 1; }
mkdir -p "$PROJECT_ROOT/logs/decoder" "$SCRATCH_ROOT"
export TMPDIR="$SCRATCH_ROOT"
export MPLCONFIGDIR="$SCRATCH_ROOT/matplotlib"
export TRITON_CACHE_DIR="$SCRATCH_ROOT/triton"
export PYTHONPATH="$PROJECT_ROOT"
mkdir -p "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

set -a
source "$PROJECT_ROOT/.env"
set +a

cd "$PROJECT_ROOT/Evaluation/structure_rec"
srun "$PYTHON_BIN" -B train_decoder.py \
  --encoder ca-cond \
  --run-id "$RUN_ID" \
  --resume-from "$RESUME_CKPT" \
  --resume-step "$RESUME_STEP" \
  --max-steps 200000 \
  --eval-every 2000 \
  --eval-subset-size 200 \
  --save-every 10000 \
  --batch-size 8 \
  --lr 0.0001 \
  --geometry-weight 0.0 \
  --coordinate-mode ca-anchored \
  --no-wandb
