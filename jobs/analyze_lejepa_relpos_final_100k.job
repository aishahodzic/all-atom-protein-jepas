#!/bin/bash
# Extract matched frozen online-encoder latents and generate final 100k t-SNEs.
#SBATCH --job-name=lejepa_relpos_tsne
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --gres=gpu:1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/latent_viz/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON=/slurm-storage/aishod/envs/la-proteina/bin/python

set -a
source "$PROJECT_ROOT/.env"
set +a

if [[ "$(hostname -s)" == "hopper" ]]; then
    export DATA_PATH="${DATA_PATH/\/mnt\/hopper-raid/\/mnt\/raid}"
fi

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT"
export MPLCONFIGDIR="/tmp/matplotlib-$SLURM_JOB_ID"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
mkdir -p "$PROJECT_ROOT/logs/latent_viz" "$MPLCONFIGDIR"

srun "$PYTHON" Evaluation/latent_viz/analyze_lejepa_relpos_final_100k.py
