#!/bin/bash
# Four shortest observed STB tasks for the cropped per-protein-rotation B96,
# high-LR canonical LeJEPA checkpoint at exactly 15k steps.
# Historical high-20k elapsed times: FlexBFactor ~9m, Ept ~10.5m,
# FlexNEQ ~10.5m, FlexRMSF ~11.5m.
#SBATCH --job-name=stb_protrot_hi15_short4
#SBATCH --partition=normal
#SBATCH --qos=medium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/stb/publication_upstream/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
STB_ROOT="$PROJECT_ROOT/StructTokenBench"
TRAIN_PYTHON_BIN=/slurm-storage/aishod/envs/la-proteina/bin/python
STB_PYTHON_BIN=/slurm-storage/aishod/.conda/envs/pstbench/bin/python
RUN_NAME=canonical_lejepa_crop_fixed96_protein_perview_sigreg_b96_independent_locals_rotations_lr1e3_cosine_17k
SOURCE_DIR="$PROJECT_ROOT/store/$RUN_NAME/checkpoints"
RAW_CHECKPOINT="$SOURCE_DIR/step-00015000.ckpt"
CANONICAL_CONFIG="$SOURCE_DIR/exp_config_${RUN_NAME}.json"
STAGED_CHECKPOINT="$PROJECT_ROOT/store/$RUN_NAME/evaluation/canonical-lejepa-protein-perview-rot-high-lr-step15000-raw-staged.ckpt"
ENCODER_CONFIG="$STB_ROOT/100k-checkpoints/shared/exp_config_jepa_nn130m.json"
EXPERIMENT=canonical-lejepa-protein-perview-rot-high-lr-raw-step15k

set -a
source "$PROJECT_ROOT/.env"
set +a

test -s "$RAW_CHECKPOINT"
test -s "$CANONICAL_CONFIG"
test -s "$ENCODER_CONFIG"

"$TRAIN_PYTHON_BIN" -c '
import json
import sys
import torch

checkpoint_path, config_path = sys.argv[1:]
with open(config_path, encoding="utf-8") as handle:
    config = json.load(handle)
assert config["alignment_level"] == "protein", config["alignment_level"]
assert config["independent_view_rotations"] is True
assert config["dataset"]["datamodule"]["batch_size"] == 48
assert config["trainer"]["devices"] == 2
assert config["optimizer"]["lr"] == 1.0e-3
assert config["schedule"]["total_steps"] == 30_000
checkpoint = torch.load(checkpoint_path, map_location="cpu", weights_only=False, mmap=True)
assert checkpoint.get("global_step") == 15_000, checkpoint.get("global_step")
raw = checkpoint.get("state_dict", {})
assert sum(str(key).startswith("encoder.") for key in raw) == 381
print("Verified per-protein rotations, global B96, high LR, raw step-15k source")
' "$RAW_CHECKPOINT" "$CANONICAL_CONFIG"

mkdir -p "$(dirname "$STAGED_CHECKPOINT")"
temporary_staged="${STAGED_CHECKPOINT}.tmp-${SLURM_JOB_ID}"
"$TRAIN_PYTHON_BIN" -m Evaluation.canonical_lejepa.stage_for_structtokenbench \
    "$RAW_CHECKPOINT" "$temporary_staged" --encoder-source=raw
mv "$temporary_staged" "$STAGED_CHECKPOINT"

"$TRAIN_PYTHON_BIN" -c '
import hashlib
import sys
import torch

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

source_path, staged_path = sys.argv[1:]
staged = torch.load(staged_path, map_location="cpu", weights_only=False, mmap=True)
provenance = staged.get("canonical_lejepa_evaluation", {})
assert provenance.get("encoder_source") == "raw", provenance
assert provenance.get("source_global_step") == 15_000, provenance
assert provenance.get("source_checkpoint_sha256") == sha256(source_path), provenance
assert provenance.get("latent_dim") == 8, provenance
state = staged.get("state_dict", {})
assert sum(str(key).startswith("online_encoder.") for key in state) == 381
print(f"Verified staged step-15k checkpoint: {provenance}")
' "$RAW_CHECKPOINT" "$STAGED_CHECKPOINT"

cd "$STB_ROOT"
export STB_SKIP_BOOTSTRAP=1
export STB_SKIP_DATA_SETUP=1
export STB_SMOKE=0
export STB_SHARED_EMBEDDING_CACHE=1
export STB_SHARED_EMBEDDING_CACHE_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data/shared_embedding_cache
export DS_IGNORE_CUDA_DETECTION=1
export PYTHON_BIN="$STB_PYTHON_BIN"
export NUM_WORKERS=8
export PDB_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_pdb_data
export STB_RELEASE_DATA_ROOT=/mnt/hopper-raid/aishod/data/struct_token_bench_release_data
export CANONICAL_LEJEPA_PROTEIN_PERVIEW_ROT_HIGH_LR_RAW_STEP15K_CKPT="$STAGED_CHECKPOINT"
export EVALUATION_RUN_ID="slurm-${SLURM_JOB_ID}-${EXPERIMENT}-shortest-four"
export STB_LOG_ROOT="$STB_ROOT/struct_token_bench_logs/upstream-l600-v1-full/runs/$EVALUATION_RUN_ID"
export SUMMARY_FILE="$STB_LOG_ROOT/summary_results.csv"
export TMPDIR="$HOME/tmp/stb-runtime-cache/${SLURM_JOB_ID}-protrot-high15-short4"
export MPLCONFIGDIR="$TMPDIR/matplotlib"
export TRITON_CACHE_DIR="$TMPDIR/triton"
mkdir -p "$STB_LOG_ROOT" "$TMPDIR" "$MPLCONFIGDIR" "$TRITON_CACHE_DIR" "$STB_SHARED_EMBEDDING_CACHE_ROOT"

bash src/script/run_eval.sh \
    --protocol=upstream-l600-v1 \
    --checkpoint=15k \
    --experiment="$EXPERIMENT" \
    --tasks=FlexBFactor,Ept,FlexNEQ,FlexRMSF
