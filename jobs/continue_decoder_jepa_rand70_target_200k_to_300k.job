#!/bin/bash
# Continue the original, non-rotation JEPA rand-70 target decoder from its
# exact step-200k weights to step 300k. Decoder checkpoints contain weights
# only, so AdamW restarts on resume. No training-time geometry regularizer;
# deterministic geometry postprocessing is applied only during export.
#SBATCH --job-name=dec_jr70_t300k
#SBATCH --partition=normal
#SBATCH --qos=long
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=100G
#SBATCH --time=18:00:00
#SBATCH --output=/mnt/data/slurm-storage/aishod/projects/la-proteina/logs/decoder/%x-%j.out

set -euo pipefail

PROJECT_ROOT=/mnt/data/slurm-storage/aishod/projects/la-proteina
PYTHON_BIN=/data-gauss/$USER/envs/laproteina_env/bin/python3
SOURCE_RUN_ID=jepa-rand-mask-70-target-140k-to-200k
RUN_ID=jepa-rand-mask-70-target-200k-to-300k
RESUME_STEP=200000
RESUME_CKPT="$PROJECT_ROOT/Evaluation/structure_rec/checkpoints/${SOURCE_RUN_ID}_step${RESUME_STEP}.pt"
SCRATCH_ROOT="$HOME/tmp/decoder-jr70-300k-$SLURM_JOB_ID"

[[ -s "$RESUME_CKPT" ]] || { echo "ERROR: missing exact step-200k decoder checkpoint: $RESUME_CKPT" >&2; exit 1; }
mkdir -p "$PROJECT_ROOT/logs/decoder" "$SCRATCH_ROOT"
export TMPDIR="$SCRATCH_ROOT"
export MPLCONFIGDIR="$SCRATCH_ROOT/matplotlib"
export TRITON_CACHE_DIR="$SCRATCH_ROOT/triton"
export PYTHONPATH="$PROJECT_ROOT"
mkdir -p "$MPLCONFIGDIR" "$TRITON_CACHE_DIR"

set -a
source "$PROJECT_ROOT/.env"
set +a

cd "$PROJECT_ROOT/Evaluation/structure_rec"
srun "$PYTHON_BIN" -B train_decoder.py \
  --encoder jepa-rand-mask-70 \
  --encoder-source target \
  --run-id "$RUN_ID" \
  --resume-from "$RESUME_CKPT" \
  --resume-step "$RESUME_STEP" \
  --max-steps 300000 \
  --eval-every 2000 \
  --eval-subset-size 200 \
  --save-every 50000 \
  --batch-size 8 \
  --lr 0.0001 \
  --geometry-weight 0.0 \
  --no-wandb
